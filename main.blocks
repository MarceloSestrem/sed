<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="H]*|{R]Bl`X*.P*1*r0E" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="B24lu+@5LAbq0C)m!YF%"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace SED {" line1="" line2="    // --- ENUMERAÇÕES ---" line3="" line4="    export enum PingUnit {" line5="        //% block=&quot;cm&quot;" line6="        cm," line7="        //% block=&quot;polegadas&quot;" line8="        inch," line9="        //% block=&quot;μs&quot;" line10="        MicroSeconds" line11="    }" line12="" line13="    export enum DistanceUnit {" line14="        //% block=&quot;cm&quot;" line15="        cm," line16="        //% block=&quot;polegadas&quot;" line17="        inch" line18="    }" line19="" line20="    export enum Color {" line21="        //% block=&quot;Vermelho&quot;" line22="        Red," line23="        //% block=&quot;Verde&quot;" line24="        Green," line25="        //% block=&quot;Azul&quot;" line26="        Blue," line27="        //% block=&quot;Transparente&quot;" line28="        Clear" line29="    }" line30="" line31="    export enum ColorList {" line32="        //% block=&quot;Vermelho&quot;" line33="        red," line34="        //% block=&quot;Verde&quot;" line35="        green," line36="        //% block=&quot;Azul&quot;" line37="        blue," line38="        //% block=&quot;Ciano&quot;" line39="        cyan," line40="        //% block=&quot;Magenta&quot;" line41="        magenta," line42="        //% block=&quot;Amarelo&quot;" line43="        yellow," line44="        //% block=&quot;Branco&quot;" line45="        white" line46="    }" line47="" line48="    export enum GasList {" line49="        //% block=&quot;CO&quot;" line50="        Co," line51="        //% block=&quot;CO2&quot;" line52="        Co2," line53="        //% block=&quot;Fumaça&quot;" line54="        Smoke," line55="        //% block=&quot;Álcool&quot;" line56="        Alcohol" line57="    }" line58="" line59="    export enum LcdPosition1602 {" line60="        Pos1 = 1, Pos2 = 2, Pos3 = 3, Pos4 = 4, Pos5 = 5," line61="        Pos6 = 6, Pos7 = 7, Pos8 = 8, Pos9 = 9, Pos10 = 10," line62="        Pos11 = 11, Pos12 = 12, Pos13 = 13, Pos14 = 14, Pos15 = 15," line63="        Pos16 = 16, Pos17 = 17, Pos18 = 18, Pos19 = 19, Pos20 = 20," line64="        Pos21 = 21, Pos22 = 22, Pos23 = 23, Pos24 = 24, Pos25 = 25," line65="        Pos26 = 26, Pos27 = 27, Pos28 = 28, Pos29 = 29, Pos30 = 30," line66="        Pos31 = 31, Pos32 = 32" line67="    }" line68="" line69="    export enum LcdPosition2004 {" line70="        Pos1 = 1, Pos2 = 2, Pos3 = 3, Pos4 = 4, Pos5 = 5," line71="        Pos6 = 6, Pos7 = 7, Pos8 = 8, Pos9 = 9, Pos10 = 10," line72="        Pos11 = 11, Pos12 = 12, Pos13 = 13, Pos14 = 14, Pos15 = 15," line73="        Pos16 = 16, Pos17 = 17, Pos18 = 18, Pos19 = 19, Pos20 = 20," line74="        Pos21 = 21, Pos22 = 22, Pos23 = 23, Pos24 = 24, Pos25 = 25," line75="        Pos26 = 26, Pos27 = 27, Pos28 = 28, Pos29 = 29, Pos30 = 30," line76="        Pos31 = 31, Pos32 = 32, Pos33 = 33, Pos34 = 34, Pos35 = 35," line77="        Pos36 = 36, Pos37 = 37, Pos38 = 38, Pos39 = 39, Pos40 = 40," line78="        Pos41 = 41, Pos42 = 42, Pos43 = 43, Pos44 = 44, Pos45 = 45," line79="        Pos46 = 46, Pos47 = 47, Pos48 = 48, Pos49 = 49, Pos50 = 50," line80="        Pos51 = 51, Pos52 = 52, Pos53 = 53, Pos54 = 54, Pos55 = 55," line81="        Pos56 = 56, Pos57 = 57, Pos58 = 58, Pos59 = 59, Pos60 = 60," line82="        Pos61 = 61, Pos62 = 62, Pos63 = 63, Pos64 = 64, Pos65 = 65," line83="        Pos66 = 66, Pos67 = 67, Pos68 = 68, Pos69 = 69, Pos70 = 70," line84="        Pos71 = 71, Pos72 = 72, Pos73 = 73, Pos74 = 74, Pos75 = 75," line85="        Pos76 = 76, Pos77 = 77, Pos78 = 78, Pos79 = 79, Pos80 = 80" line86="    }" line87="" line88="    export enum LcdBacklight {" line89="        //% block=&quot;desligada&quot;" line90="        Off = 0," line91="        //% block=&quot;ligada&quot;" line92="        On = 8" line93="    }" line94="" line95="    export enum TextAlignment {" line96="        //% block=&quot;alinhado à esquerda&quot;" line97="        Left," line98="        //% block=&quot;alinhado à direita&quot;" line99="        Right" line100="    }" line101="" line102="    export enum TextOption {" line103="        //% block=&quot;alinhar à esquerda&quot;" line104="        AlignLeft," line105="        //% block=&quot;alinhar à direita&quot;" line106="        AlignRight," line107="        //% block=&quot;preencher com zeros&quot;" line108="        PadWithZeros" line109="    }" line110="" line111="    // ==========================================" line112="    // SUBCATEGORIA: MATEMÁTICA" line113="    // ==========================================" line114="" line115="    /**" line116="     * Arredonda um número para a quantidade desejada de casas decimais" line117="     */" line118="    //% subcategory=&quot;Matemática&quot;" line119="    //% blockId=sed_arredondar_casas" line120="    //% block=&quot;arredondar %valor para %casas casas decimais&quot;" line121="    //% valor.defl=3.14159" line122="    //% casas.defl=2" line123="    //% weight=100" line124="    export function arredondarCasas(valor: number, casas: number): number {" line125="        let fator = Math.pow(10, Math.max(0, casas));" line126="        return Math.round(valor * fator) / fator;" line127="    }" line128="" line129="    /**" line130="     * Multiplica três valores" line131="     */" line132="    //% subcategory=&quot;Matemática&quot;" line133="    //% blockId=sed_multiplicar_tres" line134="    //% block=&quot;multiplicar %a × %b × %c&quot;" line135="    //% a.defl=1" line136="    //% b.defl=1" line137="    //% c.defl=1" line138="    //% inlineInputMode=inline" line139="    //% weight=90" line140="    export function multiplicarTres(a: number, b: number, c: number): number {" line141="        return a * b * c;" line142="    }" line143="" line144="    /**" line145="     * Soma três valores" line146="     */" line147="    //% subcategory=&quot;Matemática&quot;" line148="    //% blockId=sed_somar_tres" line149="    //% block=&quot;somar %a + %b + %c&quot;" line150="    //% a.defl=0" line151="    //% b.defl=0" line152="    //% c.defl=0" line153="    //% inlineInputMode=inline" line154="    //% weight=80" line155="    export function somarTres(a: number, b: number, c: number): number {" line156="        return a + b + c;" line157="    }" line158="" line159="    /**" line160="     * Subtrai três valores em sequência (a - b - c)" line161="     */" line162="    //% subcategory=&quot;Matemática&quot;" line163="    //% blockId=sed_subtrair_tres" line164="    //% block=&quot;subtrair %a - %b - %c&quot;" line165="    //% a.defl=0" line166="    //% b.defl=0" line167="    //% c.defl=0" line168="    //% inlineInputMode=inline" line169="    //% weight=70" line170="    export function subtrairTres(a: number, b: number, c: number): number {" line171="        return a - b - c;" line172="    }" line173="" line174="    //% subcategory=&quot;Matemática&quot;" line175="    //% blockId=sed_somar" line176="    //% block=&quot;%a + %b&quot;" line177="    //% weight=60" line178="    export function somar(a: number, b: number): number {" line179="        return a + b;" line180="    }" line181="" line182="    //% subcategory=&quot;Matemática&quot;" line183="    //% blockId=sed_subtrair" line184="    //% block=&quot;%a - %b&quot;" line185="    //% weight=59" line186="    export function subtrair(a: number, b: number): number {" line187="        return a - b;" line188="    }" line189="" line190="    //% subcategory=&quot;Matemática&quot;" line191="    //% blockId=sed_multiplicar" line192="    //% block=&quot;%a × %b&quot;" line193="    //% weight=58" line194="    export function multiplicar(a: number, b: number): number {" line195="        return a * b;" line196="    }" line197="" line198="    //% subcategory=&quot;Matemática&quot;" line199="    //% blockId=sed_dividir" line200="    //% block=&quot;%a ÷ %b&quot;" line201="    //% weight=57" line202="    export function dividir(a: number, b: number): number {" line203="        if (b == 0) return 0;" line204="        return a / b;" line205="    }" line206="" line207="    //% subcategory=&quot;Matemática&quot;" line208="    //% blockId=sed_mapear" line209="    //% block=&quot;mapear valor %val de [ %fromLow , %fromHigh ] para [ %toLow , %toHigh ]&quot;" line210="    //% weight=56" line211="    export function mapear(val: number, fromLow: number, fromHigh: number, toLow: number, toHigh: number): number {" line212="        return Math.map(val, fromLow, fromHigh, toLow, toHigh);" line213="    }" line214="" line215="    // ==========================================" line216="    // SUBCATEGORIA: SENSORES ULTRASSÔNICOS" line217="    // ==========================================" line218="" line219="    //% subcategory=&quot;Ultrassônico&quot;" line220="    //% blockId=sed_ultrasonic_distance " line221="    //% block=&quot;medidor de distância ultrassônico pino |%name| distância em %Unit&quot;" line222="    //% color=#000080" line223="    export function Ultrasonic(name: DigitalPin, Unit: DistanceUnit): number {" line224="        let duration = 0;" line225="        let RangeInCentimeters = 0;" line226="" line227="        pins.digitalWritePin(name, 0);" line228="        control.waitMicros(2);" line229="        pins.digitalWritePin(name, 1);" line230="        control.waitMicros(10);" line231="        pins.digitalWritePin(name, 0);" line232="" line233="        duration = pins.pulseIn(name, PulseValue.High, 50000);" line234="        RangeInCentimeters = duration / 29 / 2;" line235="" line236="        if (Unit == DistanceUnit.cm)" line237="            return Math.round(RangeInCentimeters);" line238="        else" line239="            return Math.round(RangeInCentimeters / 2.54);" line240="    }" line241="" line242="    //% subcategory=&quot;Ultrassônico&quot;" line243="    //% blockId=sed_ultrasonic_v2_distance " line244="    //% block=&quot;(v2) medidor de distância ultrassônico pino |%name| distância em %Unit&quot;" line245="    //% color=#000080" line246="    export function UltrasonicV2(name: DigitalPin, Unit: DistanceUnit): number {" line247="        let duration2 = 0;" line248="        let RangeInCentimeters2 = 0;" line249="" line250="        pins.digitalWritePin(name, 0);" line251="        control.waitMicros(2);" line252="        pins.digitalWritePin(name, 1);" line253="        control.waitMicros(10);" line254="        pins.digitalWritePin(name, 0);" line255="" line256="        duration2 = pins.pulseIn(name, PulseValue.High, 25000);" line257="        RangeInCentimeters2 = duration2 * 153 / 29 / 2 / 100;" line258="" line259="        if (Unit == DistanceUnit.cm)" line260="            return Math.round(RangeInCentimeters2);" line261="        else" line262="            return Math.round(RangeInCentimeters2 / 2.54);" line263="    }" line264="" line265="    //% subcategory=&quot;Ultrassônico&quot;" line266="    //% blockId=sed_ping " line267="    //% block=&quot;(HC-SR04) ultrassom pino |trig %trig|echo %echo|unidade %unit&quot;" line268="    //% color=#000080" line269="    export function ping(trig: DigitalPin, echo: DigitalPin, unit: PingUnit, maxCmDistance = 500): number {" line270="        pins.setPull(trig, PinPullMode.PullNone);" line271="        pins.digitalWritePin(trig, 0);" line272="        control.waitMicros(2);" line273="        pins.digitalWritePin(trig, 1);" line274="        control.waitMicros(10);" line275="        pins.digitalWritePin(trig, 0);" line276="" line277="        const d = pins.pulseIn(echo, PulseValue.High, maxCmDistance * 58);" line278="" line279="        switch (unit) {" line280="            case PingUnit.cm: return Math.idiv(d, 58);" line281="            case PingUnit.inch: return Math.idiv(d, 148);" line282="            default: return d;" line283="        }" line284="    }" line285="" line286="    // ==========================================" line287="    // SUBCATEGORIA: SENSORES DIGITAIS" line288="    // ==========================================" line289="" line290="    //% subcategory=&quot;Sensores Digitais&quot;" line291="    //% blockId=sed_line_finder " line292="    //% block=&quot;pino |%pin| seguidor de linha detecta preto. Inverter ação |$reverseAction|&quot;" line293="    //% reverseAction.shadow=&quot;toggleOnOff&quot;" line294="    //% color=#000080" line295="    export function lineFinder(pin: DigitalPin, reverseAction?: boolean): boolean {" line296="        if (reverseAction) {" line297="            return pins.digitalReadPin(pin) == 0;" line298="        } else {" line299="            return pins.digitalReadPin(pin) == 1;" line300="        }" line301="    }" line302="" line303="    //% subcategory=&quot;Sensores Digitais&quot;" line304="    //% blockId=sed_collision " line305="    //% block=&quot;sensor de colisão pino |%pin| ativado&quot;" line306="    //% color=#000080" line307="    export function collisionButton(pin: DigitalPin): boolean {" line308="        return pins.digitalReadPin(pin) == 0;" line309="    }" line310="" line311="    //% subcategory=&quot;Sensores Digitais&quot;" line312="    //% blockId=sed_water " line313="    //% block=&quot;sensor de água pino |%pin| detecta água&quot;" line314="    //% color=#000080" line315="    export function waterSensor(pin: DigitalPin): boolean {" line316="        return pins.digitalReadPin(pin) == 1;" line317="    }" line318="" line319="    //% subcategory=&quot;Sensores Digitais&quot;" line320="    //% blockId=sed_magnetic " line321="    //% block=&quot;chave magnética pino |%pin| ativada&quot;" line322="    //% color=#000080" line323="    export function magneticSwitch(pin: DigitalPin): boolean {" line324="        return pins.digitalReadPin(pin) == 0;" line325="    }" line326="" line327="    //% subcategory=&quot;Sensores Digitais&quot;" line328="    //% blockId=sed_hall " line329="    //% block=&quot;sensor hall pino |%pin| ativado&quot;" line330="    //% color=#000080" line331="    export function hallSensor(pin: DigitalPin): boolean {" line332="        return pins.digitalReadPin(pin) == 0;" line333="    }" line334="" line335="    //% subcategory=&quot;Sensores Digitais&quot;" line336="    //% blockId=sed_crash " line337="    //% block=&quot;sensor de impacto |%pin| pressionado&quot;" line338="    //% color=#000080" line339="    export function crashButton(pin: DigitalPin): boolean {" line340="        return pins.digitalReadPin(pin) == 0;" line341="    }" line342="" line343="    //% subcategory=&quot;Sensores Digitais&quot;" line344="    //% blockId=sed_flame " line345="    //% block=&quot;sensor de chama pino |%pin| detecta fogo&quot;" line346="    //% color=#000080" line347="    export function flameSensor(pin: DigitalPin): boolean {" line348="        return pins.digitalReadPin(pin) == 0;" line349="    }" line350="" line351="    //% subcategory=&quot;Sensores Digitais&quot;" line352="    //% blockId=sed_touch " line353="    //% block=&quot;sensor de toque pino |%pin| tocado&quot;" line354="    //% color=#000080" line355="    export function touchSensor(pin: DigitalPin): boolean {" line356="        return pins.digitalReadPin(pin) == 1;" line357="    }" line358="" line359="    //% subcategory=&quot;Sensores Digitais&quot;" line360="    //% blockId=sed_vibration " line361="    //% block=&quot;sensor de vibração pino |%pin| detecta vibração&quot;" line362="    //% color=#000080" line363="    export function vibrationSensor(pin: DigitalPin): boolean {" line364="        return pins.digitalReadPin(pin) == 1;" line365="    }" line366="" line367="    //% subcategory=&quot;Sensores Digitais&quot;" line368="    //% blockId=sed_pir " line369="    //% block=&quot;sensor PIR pino |%pin| detecta movimento&quot;" line370="    //% color=#000080" line371="    export function pirSensor(pin: DigitalPin): boolean {" line372="        return pins.digitalReadPin(pin) == 1;" line373="    }" line374="" line375="    // ==========================================" line376="    // SUBCATEGORIA: SENSORES ANALÓGICOS" line377="    // ==========================================" line378="" line379="    //% subcategory=&quot;Sensores Analógicos&quot;" line380="    //% blockId=sed_raindrop " line381="    //% block=&quot;valor do sensor de chuva (0~100) no pino %raindroppin. Intervalo (leitura) min|%vmin| máx|%vmax|&quot;" line382="    //% vmin.defl=0 vmax.defl=1023" line383="    //% color=#000080" line384="    export function raindropSensor(raindroppin: AnalogPin, vmin: number = 0, vmax: number = 1023): number {" line385="        let value = pins.analogReadPin(raindroppin);" line386="        let rain = Math.map(value, vmin, vmax, 0, 100);" line387="        return Math.round(rain);" line388="    }" line389="" line390="    //% subcategory=&quot;Sensores Analógicos&quot;" line391="    //% blockId=sed_capacitivesoilhumidity " line392="    //% block=&quot;valor da umidade do solo (0~100) no pino %capacitivesoilhumiditypin. Intervalo (leitura) min|%vmin| máx|%vmax|&quot;" line393="    //% vmin.defl=200 vmax.defl=1023" line394="    //% color=#000080" line395="    export function capacitiveSoilHumiditySensor(capacitivesoilhumiditypin: AnalogPin, vmin: number = 200, vmax: number = 1023): number {" line396="        let value2 = pins.analogReadPin(capacitivesoilhumiditypin);" line397="        let humidity = Math.map(value2, vmin, vmax, 100, 0);" line398="        return Math.round(humidity);" line399="    }" line400="" line401="    //% subcategory=&quot;Sensores Analógicos&quot;" line402="    //% blockId=sed_soilhumidity " line403="    //% block=&quot;valor da umidade do solo (0~100) no pino %soilhumiditypin&quot;" line404="    //% color=#000080" line405="    export function soilHumiditySensor(soilhumiditypin: AnalogPin): number {" line406="        let value3 = pins.analogReadPin(soilhumiditypin);" line407="        let humidity2 = Math.map(value3, 0, 1000, 0, 100);" line408="        return Math.round(humidity2);" line409="    }" line410="" line411="    //% subcategory=&quot;Sensores Analógicos&quot;" line412="    //% blockId=sed_lightintensity " line413="    //% block=&quot;valor da intensidade de luz (0~100) no pino %lightintensitypin&quot;" line414="    //% color=#000080" line415="    export function lightIntensitySensor(lightintensitypin: AnalogPin): number {" line416="        let value4 = pins.analogReadPin(lightintensitypin);" line417="        let light = Math.map(value4, 0, 750, 0, 100);" line418="        return Math.round(light);" line419="    }" line420="" line421="    //% subcategory=&quot;Sensores Analógicos&quot;" line422="    //% blockId=sed_uvlevel " line423="    //% block=&quot;sensor UV (0~15) no pino %uvlevelpin&quot;" line424="    //% color=#000080" line425="    export function uvLevelSensor(uvlevelpin: AnalogPin): number {" line426="        let value5 = pins.analogReadPin(uvlevelpin);" line427="        let uv = Math.map(value5, 0, 1023, 0, 15);" line428="        return Math.round(uv);" line429="    }" line430="" line431="    //% subcategory=&quot;Sensores Analógicos&quot;" line432="    //% blockId=sed_temperature " line433="    //% block=&quot;valor da temperatura (Celsius) no pino %temperaturepin&quot;" line434="    //% color=#000080" line435="    export function temperatureSensor(temperaturepin: AnalogPin): number {" line436="        let B = 4275;" line437="        let value6 = pins.analogReadPin(temperaturepin);" line438="        let R = 1023 / value6 - 1.0;" line439="        R = 100000 * R;" line440="        let temperature = 1.0 / (Math.log(R / 100000) / B + 1 / 298.15) - 273.15;" line441="        return Math.round(temperature);" line442="    }" line443="" line444="    //% subcategory=&quot;Sensores Analógicos&quot;" line445="    //% blockId=sed_gas " line446="    //% block=&quot;sensor de gás %sensor no pino %gaspin valor de concentração&quot;" line447="    //% color=#000080" line448="    export function gasSensor(sensor: GasList, gaspin: AnalogPin): number {" line449="        let value7 = pins.analogReadPin(gaspin);" line450="        let gas = Math.map(value7, 0, 1023, 0, 100);" line451="        return Math.round(gas);" line452="    }" line453="" line454="    //% subcategory=&quot;Sensores Analógicos&quot;" line455="    //% blockId=sed_noise " line456="    //% block=&quot;valor do ruído (dB) no pino %noisepin (0~100)&quot;" line457="    //% color=#000080" line458="    export function noiseSensor(noisepin: AnalogPin): number {" line459="        let value8 = pins.analogReadPin(noisepin);" line460="        let noise = Math.map(value8, 0, 1023, 0, 100);" line461="        return Math.round(noise);" line462="    }" line463="" line464="    // ==========================================" line465="    // SUBCATEGORIA: COR E GESTOS (I2C)" line466="    // ==========================================" line467="" line468="    //% subcategory=&quot;Cor e Gestos&quot;" line469="    //% blockId=sed_colorsensor " line470="    //% block=&quot;sensor de cor detectou %Color&quot;" line471="    //% color=#000080" line472="    export function colorSensor(Color: Color): boolean {" line473="        return false;" line474="    }" line475="" line476="    //% subcategory=&quot;Cor e Gestos&quot;" line477="    //% blockId=sed_apds9960_hue " line478="    //% block=&quot;APDS9960 obter matiz da cor HUE (0~360)&quot;" line479="    //% color=#000080" line480="    export function getHue(): number {" line481="        return 0;" line482="    }" line483="" line484="    //% subcategory=&quot;Cor e Gestos&quot;" line485="    //% blockId=sed_apds9960_check_color " line486="    //% block=&quot;sensor de cor APDS9960 detecta %color&quot;" line487="    //% color=#000080" line488="    export function checkColor(color: ColorList): boolean {" line489="        let hue = getHue();" line490="        switch (color) {" line491="            case ColorList.red:" line492="                return (hue &gt;= 330 || hue &lt; 20);" line493="            case ColorList.yellow:" line494="                return (hue &gt;= 20 &amp;&amp; hue &lt; 75);" line495="            case ColorList.green:" line496="                return (hue &gt;= 75 &amp;&amp; hue &lt; 165);" line497="            case ColorList.cyan:" line498="                return (hue &gt;= 165 &amp;&amp; hue &lt; 210);" line499="            case ColorList.blue:" line500="                return (hue &gt;= 210 &amp;&amp; hue &lt; 270);" line501="            case ColorList.magenta:" line502="                return (hue &gt;= 270 &amp;&amp; hue &lt; 330);" line503="            case ColorList.white:" line504="                return true;" line505="            default:" line506="                return false;" line507="        }" line508="    }" line509="" line510="    // ==========================================" line511="    // SUBCATEGORIA: LCD DISPLAY" line512="    // ==========================================" line513="" line514="    const enum Lcd { Command = 0, Data = 1 }" line515="" line516="    interface LcdState {" line517="        i2cAddress: uint8;" line518="        backlight: LcdBacklight;" line519="        characters: Buffer;" line520="        rows: uint8;" line521="        columns: uint8;" line522="        lineNeedsUpdate: uint8;" line523="        refreshIntervalId: number;" line524="    }" line525="" line526="    let lcdState: LcdState = undefined;" line527="" line528="    function connect(): boolean {" line529="        if (0 != pins.i2cReadNumber(39, NumberFormat.Int8LE, false)) {" line530="            connectLcd(39);" line531="        } else if (0 != pins.i2cReadNumber(63, NumberFormat.Int8LE, false)) {" line532="            connectLcd(63);" line533="        }" line534="        return !!lcdState;" line535="    }" line536="" line537="    function write4bits(value: number) {" line538="        if (!lcdState &amp;&amp; !connect()) return;" line539="        pins.i2cWriteNumber(lcdState.i2cAddress, value, NumberFormat.Int8LE);" line540="        pins.i2cWriteNumber(lcdState.i2cAddress, value | 0x04, NumberFormat.Int8LE);" line541="        control.waitMicros(1);" line542="        pins.i2cWriteNumber(lcdState.i2cAddress, value &amp; (0xff ^ 0x04), NumberFormat.Int8LE);" line543="        control.waitMicros(50);" line544="    }" line545="" line546="    function send(RS_bit: number, payload: number) {" line547="        if (!lcdState) return;" line548="        const highnib = payload &amp; 0xf0;" line549="        write4bits(highnib | lcdState.backlight | RS_bit);" line550="        const lownib = (payload &lt;&lt; 4) &amp; 0xf0;" line551="        write4bits(lownib | lcdState.backlight | RS_bit);" line552="    }" line553="" line554="    function sendCommand(command: number) { send(Lcd.Command, command); }" line555="    function sendData(data: number) { send(Lcd.Data, data); }" line556="" line557="    function setCursor(line: number, column: number) {" line558="        const offsets = [0x00, 0x40, 0x14, 0x54];" line559="        sendCommand(0x80 | (offsets[line] + column));" line560="    }" line561="" line562="    function updateCharacterBuffer(" line563="        text: string," line564="        offset: number," line565="        length: number," line566="        columns: number," line567="        rows: number," line568="        alignment: TextAlignment," line569="        pad: string" line570="    ): void {" line571="        if (!lcdState &amp;&amp; !connect()) return;" line572="" line573="        if (!lcdState.refreshIntervalId) {" line574="            lcdState.refreshIntervalId = control.setInterval(refreshDisplay, 500, control.IntervalMode.Timeout);" line575="        }" line576="" line577="        if (lcdState.columns === 0) {" line578="            lcdState.columns = columns;" line579="            lcdState.rows = rows;" line580="            lcdState.characters = pins.createBuffer(lcdState.rows * lcdState.columns);" line581="" line582="            const whitespace = &quot;x&quot;.charCodeAt(0);" line583="            for (let pos = 0; pos &lt; lcdState.rows * lcdState.columns; pos++) {" line584="                lcdState.characters[pos] = whitespace;" line585="            }" line586="            updateCharacterBuffer(&quot;&quot;, 0, lcdState.columns * lcdState.rows, lcdState.columns, lcdState.rows, TextAlignment.Left, &quot; &quot;);" line587="        }" line588="" line589="        if (columns !== lcdState.columns || rows !== lcdState.rows) return;" line590="" line591="        const fillCharacter = pad.length &gt; 0 ? pad.charCodeAt(0) : &quot; &quot;.charCodeAt(0);" line592="        let endPosition = offset + length;" line593="        if (endPosition &gt; lcdState.columns * lcdState.rows) {" line594="            endPosition = lcdState.columns * lcdState.rows;" line595="        }" line596="        let lcdPos = offset;" line597="" line598="        if (alignment == TextAlignment.Right) {" line599="            while (lcdPos &lt; endPosition - text.length) {" line600="                if (lcdState.characters[lcdPos] != fillCharacter) {" line601="                    lcdState.characters[lcdPos] = fillCharacter;" line602="                    lcdState.lineNeedsUpdate |= (1 &lt;&lt; Math.idiv(lcdPos, lcdState.columns));" line603="                }" line604="                lcdPos++;" line605="            }" line606="        }" line607="" line608="        let textPosition = 0;" line609="        while (lcdPos &lt; endPosition &amp;&amp; textPosition &lt; text.length) {" line610="            if (lcdState.characters[lcdPos] != text.charCodeAt(textPosition)) {" line611="                lcdState.characters[lcdPos] = text.charCodeAt(textPosition);" line612="                lcdState.lineNeedsUpdate |= (1 &lt;&lt; Math.idiv(lcdPos, lcdState.columns));" line613="            }" line614="            lcdPos++;" line615="            textPosition++;" line616="        }" line617="" line618="        while (lcdPos &lt; endPosition) {" line619="            if (lcdState.characters[lcdPos] != fillCharacter) {" line620="                lcdState.characters[lcdPos] = fillCharacter;" line621="                lcdState.lineNeedsUpdate |= (1 &lt;&lt; Math.idiv(lcdPos, lcdState.columns));" line622="            }" line623="            lcdPos++;" line624="        }" line625="    }" line626="" line627="    function sendLine(line: number): void {" line628="        setCursor(line, 0);" line629="        for (let position = lcdState.columns * line; position &lt; lcdState.columns * (line + 1); position++) {" line630="            sendData(lcdState.characters[position]);" line631="        }" line632="    }" line633="" line634="    function refreshDisplay() {" line635="        if (!lcdState) return;" line636="        lcdState.refreshIntervalId = undefined;" line637="        for (let i = 0; i &lt; lcdState.rows; i++) {" line638="            if (lcdState.lineNeedsUpdate &amp; (1 &lt;&lt; i)) {" line639="                lcdState.lineNeedsUpdate &amp;= ~(1 &lt;&lt; i);" line640="                sendLine(i);" line641="            }" line642="        }" line643="    }" line644="" line645="    function toAlignment(option?: TextOption): TextAlignment {" line646="        return (option === TextOption.AlignRight || option === TextOption.PadWithZeros) ? TextAlignment.Right : TextAlignment.Left;" line647="    }" line648="" line649="    function toPad(option?: TextOption): string {" line650="        return option === TextOption.PadWithZeros ? &quot;0&quot; : &quot; &quot;;" line651="    }" line652="" line653="    //% subcategory=&quot;LCD&quot;" line654="    //% blockId=&quot;sed_lcd_show_string_on_1602&quot;" line655="    //% block=&quot;LCD1602 exibir %text | na posição %startPosition=sed_lcd_position_1602 com tamanho %length || e %option&quot;" line656="    //% text.shadowOptions.toString=true " line657="    //% length.min=1 length.max=32 length.fieldOptions.precision=1" line658="    //% expandableArgumentMode=&quot;toggle&quot;" line659="    //% inlineInputMode=&quot;inline&quot;" line660="    //% weight=90" line661="    //% color=#000080 " line662="    export function showStringOnLcd1602(text: string, startPosition: number, length: number, option?: TextOption): void {" line663="        updateCharacterBuffer(text, startPosition - 1, length, 16, 2, toAlignment(option), toPad(option));" line664="    }" line665="" line666="    //% subcategory=&quot;LCD&quot;" line667="    //% blockId=&quot;sed_lcd_clear_1602&quot; block=&quot;LCD1602 limpar tela&quot;" line668="    //% weight=89" line669="    //% color=#000080 " line670="    export function clearLcd1602(): void {" line671="        showStringOnLcd1602(&quot;&quot;, 1, 32);" line672="    }" line673="" line674="    //% subcategory=&quot;LCD&quot;" line675="    //% blockId=&quot;sed_lcd_show_string_on_2004&quot;" line676="    //% block=&quot;LCD2004 exibir %text | na posição %startPosition=sed_lcd_position_2004 com tamanho %length || e %option&quot;" line677="    //% text.shadowOptions.toString=true" line678="    //% length.min=1 length.max=80 length.fieldOptions.precision=1" line679="    //% expandableArgumentMode=&quot;toggle&quot;" line680="    //% inlineInputMode=&quot;inline&quot;" line681="    //% weight=80" line682="    //% color=#000080 " line683="    export function showStringOnLcd2004(text: string, startPosition: number, length: number, option?: TextOption): void {" line684="        updateCharacterBuffer(text, startPosition - 1, length, 20, 4, toAlignment(option), toPad(option));" line685="    }" line686="" line687="    //% subcategory=&quot;LCD&quot;" line688="    //% blockId=&quot;sed_lcd_clear_2004&quot; block=&quot;LCD2004 limpar tela&quot;" line689="    //% weight=79" line690="    //% color=#000080 " line691="    export function clearLcd2004(): void {" line692="        showStringOnLcd2004(&quot;&quot;, 1, 80);" line693="    }" line694="" line695="    //% subcategory=&quot;LCD&quot;" line696="    //% blockId=sed_lcd_position_1602" line697="    //% block=&quot;%pos&quot;" line698="    //% pos.fieldEditor=&quot;gridpicker&quot;" line699="    //% pos.fieldOptions.columns=16" line700="    //% blockHidden=true" line701="    //% color=#000080 " line702="    export function position1602(pos: LcdPosition1602): number {" line703="        return pos;" line704="    }" line705="" line706="    //% subcategory=&quot;LCD&quot;" line707="    //% blockId=sed_lcd_position_2004" line708="    //% block=&quot;%pos&quot;" line709="    //% pos.fieldEditor=&quot;gridpicker&quot;" line710="    //% pos.fieldOptions.columns=20" line711="    //% blockHidden=true" line712="    //% color=#000080 " line713="    export function position2004(pos: LcdPosition2004): number {" line714="        return pos;" line715="    }" line716="" line717="    //% subcategory=&quot;LCD&quot;" line718="    //% blockId=&quot;sed_lcd_backlight&quot; block=&quot;alternar luz de fundo do LCD %backlight&quot;" line719="    //% backlight.fieldEditor=&quot;gridpicker&quot;" line720="    //% backlight.fieldOptions.columns=2" line721="    //% weight=79" line722="    //% color=#000080 " line723="    export function setLcdBacklight(backlight: LcdBacklight): void {" line724="        if (!lcdState &amp;&amp; !connect()) return;" line725="        lcdState.backlight = backlight;" line726="        send(Lcd.Command, 0);" line727="    }" line728="" line729="    //% subcategory=&quot;LCD&quot;" line730="    //% blockId=&quot;sed_lcd_set_address&quot; block=&quot;conectar LCD no endereço I2C %i2cAddress&quot;" line731="    //% i2cAddress.min=0 i2cAddress.max=127" line732="    //% weight=70" line733="    //% color=#000080 " line734="    export function connectLcd(i2cAddress: number): void {" line735="        if (lcdState &amp;&amp; lcdState.i2cAddress == i2cAddress) return;" line736="        if (0 === pins.i2cReadNumber(i2cAddress, NumberFormat.Int8LE, false)) return;" line737="" line738="        if (lcdState &amp;&amp; lcdState.refreshIntervalId) {" line739="            control.clearInterval(lcdState.refreshIntervalId, control.IntervalMode.Timeout);" line740="            lcdState.refreshIntervalId = undefined;" line741="        }" line742="" line743="        lcdState = {" line744="            i2cAddress: i2cAddress," line745="            backlight: LcdBacklight.On," line746="            columns: 0," line747="            rows: 0," line748="            characters: undefined," line749="            lineNeedsUpdate: 0," line750="            refreshIntervalId: undefined," line751="        };" line752="" line753="        basic.pause(50);" line754="        pins.i2cWriteNumber(lcdState.i2cAddress, lcdState.backlight, NumberFormat.Int8LE);" line755="        basic.pause(50);" line756="" line757="        write4bits(0x30);" line758="        control.waitMicros(4100);" line759="        write4bits(0x30);" line760="        control.waitMicros(4100);" line761="        write4bits(0x30);" line762="        control.waitMicros(4100);" line763="        write4bits(0x20);" line764="        control.waitMicros(1000);" line765="" line766="        send(Lcd.Command, 0x20 | 0x00 | 0x08 | 0x00);" line767="        control.waitMicros(1000);" line768="        send(Lcd.Command, 0x08 | 0x04 | 0x00 | 0x00);" line769="        control.waitMicros(1000);" line770="        send(Lcd.Command, 0x04 | 0x02 | 0x00);" line771="        control.waitMicros(1000);" line772="    }" line773="" line774="    //% subcategory=&quot;LCD&quot;" line775="    //% blockId=&quot;sed_lcd_is_connected&quot; block=&quot;LCD está conectado&quot;" line776="    //% weight=69" line777="    //% color=#000080 " line778="    export function isLcdConnected(): boolean {" line779="        return !!lcdState || connect();" line780="    }" line781="}" numlines="782"></mutation></block></statement></block></xml>