<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="xRRgvHNlG#rZ^u`HECiY" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="yvDu3DbxaimbfEs/sXDn"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace SED {" line1="" line2="    // --- ENUMERAÇÕES ---" line3="" line4="    export enum Leds {" line5="        ON = 1," line6="        OFF = 2" line7="    }" line8="" line9="    export enum Sensor {" line10="        Esquerdo = 1," line11="        Centro = 2," line12="        Direito = 3" line13="    }" line14="" line15="    export enum Um_sensor {" line16="        //% block=&quot;▮&quot;" line17="        branco = 1," line18="        //% block=&quot;▯&quot;" line19="        preto = 2" line20="    }" line21="" line22="    export enum Dois_sensores {" line23="        //% block=&quot;▮▮&quot;" line24="        branco_branco = 1," line25="        //% block=&quot;▮▯&quot;" line26="        branco_preto = 2," line27="        //% block=&quot;▯▮&quot;" line28="        preto_branco = 3," line29="        //% block=&quot;▯▯&quot;" line30="        preto_preto = 4" line31="    }" line32="" line33="    export enum Tres_sensores {" line34="        //% block=&quot;▮▮▮&quot;" line35="        branco_branco_branco = 1," line36="        //% block=&quot;▮▯▮&quot;" line37="        branco_preto_branco = 2," line38="        //% block=&quot;▯▮▮&quot;" line39="        preto_branco_branco = 3," line40="        //% block=&quot;▯▯▮&quot;" line41="        branco_branco_preto = 4," line42="        //% block=&quot;▮▮▯&quot;" line43="        preto_preto_branco = 5," line44="        //% block=&quot;▮▯▯&quot;" line45="        branco_preto_preto = 6," line46="        //% block=&quot;▯▮▯&quot;" line47="        preto_branco_preto = 7," line48="        //% block=&quot;▯▯▯&quot;" line49="        preto_preto_preto = 8" line50="    }" line51="" line52="    export enum PingUnit {" line53="        //% block=&quot;cm&quot;" line54="        cm," line55="        //% block=&quot;polegadas&quot;" line56="        inch," line57="        //% block=&quot;μs&quot;" line58="        MicroSeconds" line59="    }" line60="" line61="    export enum DistanceUnit {" line62="        //% block=&quot;cm&quot;" line63="        cm = 58," line64="        //% block=&quot;polegadas&quot;" line65="        inch = 148" line66="    }" line67="" line68="    export enum Color {" line69="        //% block=&quot;Vermelho&quot;" line70="        Red," line71="        //% block=&quot;Verde&quot;" line72="        Green," line73="        //% block=&quot;Azul&quot;" line74="        Blue," line75="        //% block=&quot;Transparente&quot;" line76="        Clear" line77="    }" line78="" line79="    export enum ColorList {" line80="        //% block=&quot;Vermelho&quot;" line81="        red," line82="        //% block=&quot;Verde&quot;" line83="        green," line84="        //% block=&quot;Azul&quot;" line85="        blue," line86="        //% block=&quot;Ciano&quot;" line87="        cyan," line88="        //% block=&quot;Magenta&quot;" line89="        magenta," line90="        //% block=&quot;Amarelo&quot;" line91="        yellow," line92="        //% block=&quot;Branco&quot;" line93="        white" line94="    }" line95="" line96="    export enum GasList {" line97="        //% block=&quot;CO&quot;" line98="        Co," line99="        //% block=&quot;CO2&quot;" line100="        Co2," line101="        //% block=&quot;Fumaça&quot;" line102="        Smoke," line103="        //% block=&quot;Álcool&quot;" line104="        Alcohol" line105="    }" line106="" line107="    export enum Servos {" line108="        S1 = 0x01," line109="        S2 = 0x02," line110="        S3 = 0x03," line111="        S4 = 0x04," line112="        S5 = 0x05," line113="        S6 = 0x06," line114="        S7 = 0x07," line115="        S8 = 0x08" line116="    }" line117="" line118="    export enum Motors {" line119="        M1A = 0x1," line120="        M1B = 0x2," line121="        M2A = 0x3," line122="        M2B = 0x4" line123="    }" line124="" line125="    export enum Steppers {" line126="        M1 = 0x1," line127="        M2 = 0x2" line128="    }" line129="" line130="    export enum SonarVersion {" line131="        V1 = 0x1," line132="        V2 = 0x2" line133="    }" line134="" line135="    export enum Turns {" line136="        //% blockId=&quot;T1B4&quot; block=&quot;1/4&quot;" line137="        T1B4 = 90," line138="        //% blockId=&quot;T1B2&quot; block=&quot;1/2&quot;" line139="        T1B2 = 180," line140="        //% blockId=&quot;T1B0&quot; block=&quot;1&quot;" line141="        T1B0 = 360," line142="        //% blockId=&quot;T2B0&quot; block=&quot;2&quot;" line143="        T2B0 = 720," line144="        //% blockId=&quot;T3B0&quot; block=&quot;3&quot;" line145="        T3B0 = 1080," line146="        //% blockId=&quot;T4B0&quot; block=&quot;4&quot;" line147="        T4B0 = 1440," line148="        //% blockId=&quot;T5B0&quot; block=&quot;5&quot;" line149="        T5B0 = 1800" line150="    }" line151="" line152="    export enum ValueUnit {" line153="        //% block=&quot;mm&quot;" line154="        Millimetros," line155="        //% block=&quot;cm&quot;" line156="        Centimetros" line157="    }" line158="" line159="    export enum LcdPosition1602 {" line160="        Pos1 = 1, Pos2 = 2, Pos3 = 3, Pos4 = 4, Pos5 = 5," line161="        Pos6 = 6, Pos7 = 7, Pos8 = 8, Pos9 = 9, Pos10 = 10," line162="        Pos11 = 11, Pos12 = 12, Pos13 = 13, Pos14 = 14, Pos15 = 15," line163="        Pos16 = 16, Pos17 = 17, Pos18 = 18, Pos19 = 19, Pos20 = 20," line164="        Pos21 = 21, Pos22 = 22, Pos23 = 23, Pos24 = 24, Pos25 = 25," line165="        Pos26 = 26, Pos27 = 27, Pos28 = 28, Pos29 = 29, Pos30 = 30," line166="        Pos31 = 31, Pos32 = 32" line167="    }" line168="" line169="    export enum LcdPosition2004 {" line170="        Pos1 = 1, Pos2 = 2, Pos3 = 3, Pos4 = 4, Pos5 = 5," line171="        Pos6 = 6, Pos7 = 7, Pos8 = 8, Pos9 = 9, Pos10 = 10," line172="        Pos11 = 11, Pos12 = 12, Pos13 = 13, Pos14 = 14, Pos15 = 15," line173="        Pos16 = 16, Pos17 = 17, Pos18 = 18, Pos19 = 19, Pos20 = 20," line174="        Pos21 = 21, Pos22 = 22, Pos23 = 23, Pos24 = 24, Pos25 = 25," line175="        Pos26 = 26, Pos27 = 27, Pos28 = 28, Pos29 = 29, Pos30 = 30," line176="        Pos31 = 31, Pos32 = 32, Pos33 = 33, Pos34 = 34, Pos35 = 35," line177="        Pos36 = 36, Pos37 = 37, Pos38 = 38, Pos39 = 39, Pos40 = 40," line178="        Pos41 = 41, Pos42 = 42, Pos43 = 43, Pos44 = 44, Pos45 = 45," line179="        Pos46 = 46, Pos47 = 47, Pos48 = 48, Pos49 = 49, Pos50 = 50," line180="        Pos51 = 51, Pos52 = 52, Pos53 = 53, Pos54 = 54, Pos55 = 55," line181="        Pos56 = 56, Pos57 = 57, Pos58 = 58, Pos59 = 59, Pos60 = 60," line182="        Pos61 = 61, Pos62 = 62, Pos63 = 63, Pos64 = 64, Pos65 = 65," line183="        Pos66 = 66, Pos67 = 67, Pos68 = 68, Pos69 = 69, Pos70 = 70," line184="        Pos71 = 71, Pos72 = 72, Pos73 = 73, Pos74 = 74, Pos75 = 75," line185="        Pos76 = 76, Pos77 = 77, Pos78 = 78, Pos79 = 79, Pos80 = 80" line186="    }" line187="" line188="    export enum LcdBacklight {" line189="        //% block=&quot;desligada&quot;" line190="        Off = 0," line191="        //% block=&quot;ligada&quot;" line192="        On = 8" line193="    }" line194="" line195="    export enum TextAlignment {" line196="        //% block=&quot;alinhado à esquerda&quot;" line197="        Left," line198="        //% block=&quot;alinhado à direita&quot;" line199="        Right" line200="    }" line201="" line202="    export enum TextOption {" line203="        //% block=&quot;alinhar à esquerda&quot;" line204="        AlignLeft," line205="        //% block=&quot;alinhar à direita&quot;" line206="        AlignRight," line207="        //% block=&quot;preencher com zeros&quot;" line208="        PadWithZeros" line209="    }" line210="" line211="    // --- CONSTANTES INTERNAS E VARIÁVEIS ---" line212="" line213="    const PCA9685_ADDRESS = 0x40" line214="    const MODE1 = 0x00" line215="    const MODE2 = 0x01" line216="    const SUBADR1 = 0x02" line217="    const SUBADR2 = 0x03" line218="    const SUBADR3 = 0x04" line219="    const PRESCALE = 0xFE" line220="    const LED0_ON_L = 0x06" line221="    const LED0_ON_H = 0x07" line222="    const LED0_OFF_L = 0x08" line223="    const LED0_OFF_H = 0x09" line224="    const ALL_LED_ON_L = 0xFA" line225="    const ALL_LED_ON_H = 0xFB" line226="    const ALL_LED_OFF_L = 0xFC" line227="    const ALL_LED_OFF_H = 0xFD" line228="" line229="    const STP_CHA_L = 2047" line230="    const STP_CHA_H = 4095" line231="    const STP_CHB_L = 1" line232="    const STP_CHB_H = 2047" line233="    const STP_CHC_L = 1023" line234="    const STP_CHC_H = 3071" line235="    const STP_CHD_L = 3071" line236="    const STP_CHD_H = 1023" line237="" line238="    const HT16K33_ADDRESS = 0x70" line239="    const HT16K33_BLINK_CMD = 0x80" line240="    const HT16K33_BLINK_DISPLAYON = 0x01" line241="    const HT16K33_BLINK_OFF = 0" line242="    const HT16K33_BLINK_2HZ = 1" line243="    const HT16K33_BLINK_1HZ = 2" line244="    const HT16K33_BLINK_HALFHZ = 3" line245="    const HT16K33_CMD_BRIGHTNESS = 0xE0" line246="" line247="    let initialized = false" line248="    let initializedMatrix = false" line249="    let matBuf = pins.createBuffer(17);" line250="    let distanceBuf = 0;" line251="" line252="    function i2cwrite(addr: number, reg: number, value: number) {" line253="        let buf = pins.createBuffer(2)" line254="        buf[0] = reg" line255="        buf[1] = value" line256="        pins.i2cWriteBuffer(addr, buf)" line257="    }" line258="" line259="    function i2ccmd(addr: number, value: number) {" line260="        let buf2 = pins.createBuffer(1)" line261="        buf2[0] = value" line262="        pins.i2cWriteBuffer(addr, buf2)" line263="    }" line264="" line265="    function i2cread(addr: number, reg: number) {" line266="        pins.i2cWriteNumber(addr, reg, NumberFormat.UInt8BE);" line267="        let val = pins.i2cReadNumber(addr, NumberFormat.UInt8BE);" line268="        return val;" line269="    }" line270="" line271="    function initPCA9685(): void {" line272="        i2cwrite(PCA9685_ADDRESS, MODE1, 0x00)" line273="        setFreq(50);" line274="        for (let idx = 0; idx &lt; 16; idx++) {" line275="            setPwm(idx, 0, 0);" line276="        }" line277="        initialized = true" line278="    }" line279="" line280="    function setFreq(freq: number): void {" line281="        let prescaleval = 25000000;" line282="        prescaleval /= 4096;" line283="        prescaleval /= freq;" line284="        prescaleval -= 1;" line285="        let prescale = prescaleval;" line286="        let oldmode = i2cread(PCA9685_ADDRESS, MODE1);" line287="        let newmode = (oldmode &amp; 0x7F) | 0x10;" line288="        i2cwrite(PCA9685_ADDRESS, MODE1, newmode);" line289="        i2cwrite(PCA9685_ADDRESS, PRESCALE, prescale);" line290="        i2cwrite(PCA9685_ADDRESS, MODE1, oldmode);" line291="        control.waitMicros(5000);" line292="        i2cwrite(PCA9685_ADDRESS, MODE1, oldmode | 0xa1);" line293="    }" line294="" line295="    function setPwm(channel: number, on: number, off: number): void {" line296="        if (channel &lt; 0 || channel &gt; 15) return;" line297="        let buf3 = pins.createBuffer(5);" line298="        buf3[0] = LED0_ON_L + 4 * channel;" line299="        buf3[1] = on &amp; 0xff;" line300="        buf3[2] = (on &gt;&gt; 8) &amp; 0xff;" line301="        buf3[3] = off &amp; 0xff;" line302="        buf3[4] = (off &gt;&gt; 8) &amp; 0xff;" line303="        pins.i2cWriteBuffer(PCA9685_ADDRESS, buf3);" line304="    }" line305="" line306="    function setStepper(index: number, dir: boolean): void {" line307="        if (index == 1) {" line308="            if (dir) {" line309="                setPwm(0, STP_CHA_L, STP_CHA_H);" line310="                setPwm(2, STP_CHB_L, STP_CHB_H);" line311="                setPwm(1, STP_CHC_L, STP_CHC_H);" line312="                setPwm(3, STP_CHD_L, STP_CHD_H);" line313="            } else {" line314="                setPwm(3, STP_CHA_L, STP_CHA_H);" line315="                setPwm(1, STP_CHB_L, STP_CHB_H);" line316="                setPwm(2, STP_CHC_L, STP_CHC_H);" line317="                setPwm(0, STP_CHD_L, STP_CHD_H);" line318="            }" line319="        } else {" line320="            if (dir) {" line321="                setPwm(4, STP_CHA_L, STP_CHA_H);" line322="                setPwm(6, STP_CHB_L, STP_CHB_H);" line323="                setPwm(5, STP_CHC_L, STP_CHC_H);" line324="                setPwm(7, STP_CHD_L, STP_CHD_H);" line325="            } else {" line326="                setPwm(7, STP_CHA_L, STP_CHA_H);" line327="                setPwm(5, STP_CHB_L, STP_CHB_H);" line328="                setPwm(6, STP_CHC_L, STP_CHC_H);" line329="                setPwm(4, STP_CHD_L, STP_CHD_H);" line330="            }" line331="        }" line332="    }" line333="" line334="    function stopMotor(index: number) {" line335="        setPwm((index - 1) * 2, 0, 0);" line336="        setPwm((index - 1) * 2 + 1, 0, 0);" line337="    }" line338="" line339="    function matrixInit() {" line340="        i2ccmd(HT16K33_ADDRESS, 0x21);" line341="        i2ccmd(HT16K33_ADDRESS, HT16K33_BLINK_CMD | HT16K33_BLINK_DISPLAYON | (0 &lt;&lt; 1));" line342="        i2ccmd(HT16K33_ADDRESS, HT16K33_CMD_BRIGHTNESS | 0xF);" line343="    }" line344="" line345="    function matrixShow() {" line346="        matBuf[0] = 0x00;" line347="        pins.i2cWriteBuffer(HT16K33_ADDRESS, matBuf);" line348="    }" line349="" line350="    // ==========================================" line351="    // SUBCATEGORIA: MATEMÁTICA" line352="    // ==========================================" line353="" line354="    //% subcategory=&quot;Matemática&quot;" line355="    //% blockId=sed_arredondar_casas" line356="    //% block=&quot;arredondar %valor para %casas casas decimais&quot;" line357="    //% valor.defl=3.14159 casas.defl=2" line358="    //% weight=100 color=#000080" line359="    export function arredondarCasas(valor: number, casas: number): number {" line360="        let fator = Math.pow(10, Math.max(0, casas));" line361="        return Math.round(valor * fator) / fator;" line362="    }" line363="" line364="    //% subcategory=&quot;Matemática&quot;" line365="    //% blockId=sed_multiplicar_tres" line366="    //% block=&quot;multiplicar %a × %b × %c&quot;" line367="    //% a.defl=1 b.defl=1 c.defl=1" line368="    //% inlineInputMode=inline weight=90 color=#000080" line369="    export function multiplicarTres(a: number, b: number, c: number): number {" line370="        return a * b * c;" line371="    }" line372="" line373="    //% subcategory=&quot;Matemática&quot;" line374="    //% blockId=sed_somar_tres" line375="    //% block=&quot;somar %a + %b + %c&quot;" line376="    //% a.defl=0 b.defl=0 c.defl=0" line377="    //% inlineInputMode=inline weight=80 color=#000080" line378="    export function somarTres(a: number, b: number, c: number): number {" line379="        return a + b + c;" line380="    }" line381="" line382="    //% subcategory=&quot;Matemática&quot;" line383="    //% blockId=sed_subtrair_tres" line384="    //% block=&quot;subtrair %a - %b - %c&quot;" line385="    //% a.defl=0 b.defl=0 c.defl=0" line386="    //% inlineInputMode=inline weight=70 color=#000080" line387="    export function subtrairTres(a: number, b: number, c: number): number {" line388="        return a - b - c;" line389="    }" line390="" line391="    //% subcategory=&quot;Matemática&quot;" line392="    //% blockId=sed_somar block=&quot;%a + %b&quot;" line393="    //% weight=60 color=#000080" line394="    export function somar(a: number, b: number): number {" line395="        return a + b;" line396="    }" line397="" line398="    //% subcategory=&quot;Matemática&quot;" line399="    //% blockId=sed_subtrair block=&quot;%a - %b&quot;" line400="    //% weight=59 color=#000080" line401="    export function subtrair(a: number, b: number): number {" line402="        return a - b;" line403="    }" line404="" line405="    //% subcategory=&quot;Matemática&quot;" line406="    //% blockId=sed_multiplicar block=&quot;%a × %b&quot;" line407="    //% weight=58 color=#000080" line408="    export function multiplicar(a: number, b: number): number {" line409="        return a * b;" line410="    }" line411="" line412="    //% subcategory=&quot;Matemática&quot;" line413="    //% blockId=sed_dividir block=&quot;%a ÷ %b&quot;" line414="    //% weight=57 color=#000080" line415="    export function dividir(a: number, b: number): number {" line416="        if (b == 0) return 0;" line417="        return a / b;" line418="    }" line419="" line420="    //% subcategory=&quot;Matemática&quot;" line421="    //% blockId=sed_mapear" line422="    //% block=&quot;mapear valor %val de [ %fromLow , %fromHigh ] para [ %toLow , %toHigh ]&quot;" line423="    //% weight=56 color=#000080" line424="    export function mapear(val: number, fromLow: number, fromHigh: number, toLow: number, toHigh: number): number {" line425="        return Math.map(val, fromLow, fromHigh, toLow, toHigh);" line426="    }" line427="" line428="    // ==========================================" line429="    // SUBCATEGORIA: MOTORES" line430="    // ==========================================" line431="" line432="    //% subcategory=&quot;Motores&quot;" line433="    //% blockId=robotbit_motor_run block=&quot;Motor|%index|velocidade %speed&quot;" line434="    //% group=&quot;Motores&quot; weight=59 color=#000080" line435="    //% speed.min=-255 speed.max=255" line436="    //% name.fieldEditor=&quot;gridpicker&quot; name.fieldOptions.columns=4" line437="    export function MotorRun(index: Motors, speed: number): void {" line438="        if (!initialized) {" line439="            initPCA9685()" line440="        }" line441="        speed = speed * 16;" line442="        if (speed &gt;= 4096) speed = 4095;" line443="        if (speed &lt;= -4096) speed = -4095;" line444="        if (index &gt; 4 || index &lt;= 0) return;" line445="        let pp = (index - 1) * 2;" line446="        let pn = (index - 1) * 2 + 1;" line447="        if (speed &gt;= 0) {" line448="            setPwm(pp, 0, speed);" line449="            setPwm(pn, 0, 0);" line450="        } else {" line451="            setPwm(pp, 0, 0);" line452="            setPwm(pn, 0, -speed);" line453="        }" line454="    }" line455="" line456="    //% subcategory=&quot;Motores&quot;" line457="    //% blockId=robotbit_motor_dual block=&quot;Motores|%motor1|velocidade %speed1|%motor2|velocidade %speed2&quot;" line458="    //% group=&quot;Motores&quot; weight=58 color=#000080" line459="    //% speed1.min=-255 speed1.max=255" line460="    //% speed2.min=-255 speed2.max=255" line461="    //% name.fieldEditor=&quot;gridpicker&quot; name.fieldOptions.columns=4" line462="    export function MotorRunDual(motor1: Motors, speed1: number, motor2: Motors, speed2: number): void {" line463="        MotorRun(motor1, speed1);" line464="        MotorRun(motor2, speed2);" line465="    }" line466="" line467="    //% subcategory=&quot;Motores&quot;" line468="    //% blockId=robotbit_motor_dual_DELAY block=&quot;Motores com delay |%motor1|velocidade %speed1|%motor2|velocidade %speed2 espera(em seg.) %delay&quot;" line469="    //% group=&quot;Motores&quot; weight=62 color=#000080" line470="    //% speed1.min=-255 speed1.max=255" line471="    //% speed2.min=-255 speed2.max=255" line472="    //% name.fieldEditor=&quot;gridpicker&quot; name.fieldOptions.columns=5" line473="    export function MotorRunDualDELAY(motor1: Motors, speed1: number, motor2: Motors, speed2: number, delay: number): void {" line474="        MotorRun(motor1, speed1);" line475="        MotorRun(motor2, speed2);" line476="        basic.pause(delay * 1000);" line477="        MotorRun(motor1, 0);" line478="        MotorRun(motor2, 0);" line479="    }" line480="" line481="    //% subcategory=&quot;Motores&quot;" line482="    //% blockId=robotbit_motor_rundelay block=&quot;Motor|%index|velocidade %speed|espera %delay|s&quot;" line483="    //% group=&quot;Motores&quot; weight=57 color=#000080" line484="    //% speed.min=-255 speed.max=255" line485="    //% name.fieldEditor=&quot;gridpicker&quot; name.fieldOptions.columns=4" line486="    export function MotorRunDelay(index: Motors, speed: number, delay: number): void {" line487="        MotorRun(index, speed);" line488="        basic.pause(delay * 1000);" line489="        MotorRun(index, 0);" line490="    }" line491="" line492="    //% subcategory=&quot;Motores&quot;" line493="    //% blockId=robotbit_stop block=&quot;Parar Motor|%index|&quot;" line494="    //% group=&quot;Motores&quot; weight=56 color=#000080" line495="    export function MotorStop(index: Motors): void {" line496="        MotorRun(index, 0);" line497="    }" line498="" line499="    //% subcategory=&quot;Motores&quot;" line500="    //% blockId=robotbit_stop_all block=&quot;Parando todos os motores&quot;" line501="    //% group=&quot;Motores&quot; weight=55 color=#000080" line502="    //% blockGap=50" line503="    export function MotorStopAll(): void {" line504="        if (!initialized) {" line505="            initPCA9685();" line506="        }" line507="        for (let idx2 = 1; idx2 &lt;= 4; idx2++) {" line508="            stopMotor(idx2);" line509="        }" line510="    }" line511="" line512="    // ==========================================" line513="    // SUBCATEGORIA: ULTRASSÔNICO" line514="    // ==========================================" line515="" line516="    const MICROBIT_LABCODE_ULTRASONIC_OBJECT_DETECTED_ID = 798;" line517="    const MAX_ULTRASONIC_TRAVEL_TIME = 300 * DistanceUnit.cm;" line518="    const ULTRASONIC_MEASUREMENTS = 3;" line519="" line520="    interface UltrasonicRoundTrip {" line521="        ts: number;" line522="        rtt: number;" line523="    }" line524="" line525="    interface UltrasonicDevice {" line526="        trig: DigitalPin | undefined;" line527="        roundTrips: UltrasonicRoundTrip[];" line528="        medianRoundTrip: number;" line529="        travelTimeObservers: number[];" line530="    }" line531="" line532="    let ultrasonicState: UltrasonicDevice;" line533="" line534="    //% subcategory=&quot;Ultrassônico&quot;" line535="    //% blockId=sed_ultrasonic_distance " line536="    //% block=&quot;medidor de distância ultrassônico pino |%name| distância em %Unit&quot;" line537="    //% color=#000080" line538="    export function Ultrasonic(name: DigitalPin, Unit: DistanceUnit): number {" line539="        let duration = 0;" line540="        let RangeInCentimeters = 0;" line541="" line542="        pins.digitalWritePin(name, 0);" line543="        control.waitMicros(2);" line544="        pins.digitalWritePin(name, 1);" line545="        control.waitMicros(10);" line546="        pins.digitalWritePin(name, 0);" line547="" line548="        duration = pins.pulseIn(name, PulseValue.High, 50000);" line549="        RangeInCentimeters = duration / 29 / 2;" line550="" line551="        if (Unit == DistanceUnit.cm)" line552="            return Math.round(RangeInCentimeters);" line553="        else" line554="            return Math.round(RangeInCentimeters / 2.54);" line555="    }" line556="" line557="    //% subcategory=&quot;Ultrassônico&quot;" line558="    //% blockId=sed_ultrasonic_v2_distance " line559="    //% block=&quot;(v2) medidor de distância ultrassônico pino |%name| distância em %Unit&quot;" line560="    //% color=#000080" line561="    export function UltrasonicV2(name: DigitalPin, Unit: DistanceUnit): number {" line562="        let duration2 = 0;" line563="        let RangeInCentimeters2 = 0;" line564="" line565="        pins.digitalWritePin(name, 0);" line566="        control.waitMicros(2);" line567="        pins.digitalWritePin(name, 1);" line568="        control.waitMicros(10);" line569="        pins.digitalWritePin(name, 0);" line570="" line571="        duration2 = pins.pulseIn(name, PulseValue.High, 25000);" line572="        RangeInCentimeters2 = duration2 * 153 / 29 / 2 / 100;" line573="" line574="        if (Unit == DistanceUnit.cm)" line575="            return Math.round(RangeInCentimeters2);" line576="        else" line577="            return Math.round(RangeInCentimeters2 / 2.54);" line578="    }" line579="" line580="    //% subcategory=&quot;Ultrassônico&quot;" line581="    //% blockId=sed_ping " line582="    //% block=&quot;(HC-SR04) ultrassom pino |trig %trig|echo %echo|unidade %unit&quot;" line583="    //% color=#000080" line584="    export function ping(trig: DigitalPin, echo: DigitalPin, unit: PingUnit, maxCmDistance = 500): number {" line585="        pins.setPull(trig, PinPullMode.PullNone);" line586="        pins.digitalWritePin(trig, 0);" line587="        control.waitMicros(2);" line588="        pins.digitalWritePin(trig, 1);" line589="        control.waitMicros(10);" line590="        pins.digitalWritePin(trig, 0);" line591="" line592="        const d = pins.pulseIn(echo, PulseValue.High, maxCmDistance * 58);" line593="" line594="        switch (unit) {" line595="            case PingUnit.cm: return Math.idiv(d, 58);" line596="            case PingUnit.inch: return Math.idiv(d, 148);" line597="            default: return d;" line598="        }" line599="    }" line600="" line601="    //% subcategory=&quot;Ultrassônico&quot;" line602="    //% group=&quot;Ultrassônico versão compacta&quot;" line603="    //% blockId=&quot;labcode_ultrasonico_conectado&quot;" line604="    //% block=&quot;Sensor Ultrassônico pino TRIG %trig pino ECHO %echo %unit&quot;" line605="    //% weight=94 color=#000080" line606="    export function readUltrassonic(trig: DigitalPin, echo: DigitalPin): number {" line607="        let data;" line608="        pins.digitalWritePin(trig, 1);" line609="        basic.pause(1);" line610="        pins.digitalWritePin(trig, 0);" line611="        if (pins.digitalReadPin(echo) == 0) {" line612="            pins.digitalWritePin(trig, 0);" line613="            pins.digitalWritePin(trig, 1);" line614="            basic.pause(20);" line615="            pins.digitalWritePin(trig, 0);" line616="            data = pins.pulseIn(echo, PulseValue.High, 500 * 58);" line617="        } else {" line618="            pins.digitalWritePin(trig, 1);" line619="            pins.digitalWritePin(trig, 0);" line620="            basic.pause(20);" line621="            pins.digitalWritePin(trig, 0);" line622="            data = pins.pulseIn(echo, PulseValue.High, 500 * 58);" line623="        }" line624="        data = data / 59;" line625="        if (data &lt;= 0) return 0;" line626="        if (data &gt; 500) return 500;" line627="        return Math.round(data);" line628="    }" line629="" line630="    //% subcategory=&quot;Ultrassônico&quot;" line631="    //% group=&quot;Ultrassônico&quot;" line632="    //% blockId=&quot;labcode_ultrasonico_connectado&quot;" line633="    //% block=&quot;Sensor de distancia ultrassônica | Trig em %trig | e Echo em %echo&quot;" line634="    //% trig.fieldEditor=&quot;gridpicker&quot; trig.fieldOptions.columns=4 trig.fieldOptions.tooltips=&quot;false&quot;" line635="    //% echo.fieldEditor=&quot;gridpicker&quot; echo.fieldOptions.columns=4 echo.fieldOptions.tooltips=&quot;false&quot;" line636="    //% weight=80 color=#000080" line637="    export function connectUltrasonicDistanceSensor(trig: DigitalPin, echo: DigitalPin): void {" line638="        if (ultrasonicState &amp;&amp; ultrasonicState.trig) return;" line639="" line640="        if (!ultrasonicState) {" line641="            ultrasonicState = {" line642="                trig: trig," line643="                roundTrips: [{ ts: 0, rtt: MAX_ULTRASONIC_TRAVEL_TIME }]," line644="                medianRoundTrip: MAX_ULTRASONIC_TRAVEL_TIME," line645="                travelTimeObservers: []," line646="            };" line647="        } else {" line648="            ultrasonicState.trig = trig;" line649="        }" line650="" line651="        pins.onPulsed(echo, PulseValue.High, () =&gt; {" line652="            if (" line653="                pins.pulseDuration() &lt; MAX_ULTRASONIC_TRAVEL_TIME &amp;&amp;" line654="                ultrasonicState.roundTrips.length &lt;= ULTRASONIC_MEASUREMENTS" line655="            ) {" line656="                ultrasonicState.roundTrips.push({" line657="                    ts: input.runningTime()," line658="                    rtt: pins.pulseDuration()," line659="                });" line660="            }" line661="        });" line662="" line663="        control.inBackground(measureInBackground);" line664="    }" line665="" line666="    //% subcategory=&quot;Ultrassônico&quot;" line667="    //% group=&quot;Ultrassônico&quot;" line668="    //% blockId=labcode_ultrasonic_on_object_detected" line669="    //% block=&quot;Objeto detectado a | %distance | %unit&quot;" line670="    //% weight=69 color=#000080" line671="    export function onUltrasonicObjectDetected(distance: number, unit: DistanceUnit, handler: () =&gt; void) {" line672="        if (distance &lt;= 0) return;" line673="" line674="        if (!ultrasonicState) {" line675="            ultrasonicState = {" line676="                trig: undefined," line677="                roundTrips: [{ ts: 0, rtt: MAX_ULTRASONIC_TRAVEL_TIME }]," line678="                medianRoundTrip: MAX_ULTRASONIC_TRAVEL_TIME," line679="                travelTimeObservers: []," line680="            };" line681="        }" line682="" line683="        const travelTimeThreshold = Math.imul(distance, unit);" line684="        ultrasonicState.travelTimeObservers.push(travelTimeThreshold);" line685="" line686="        control.onEvent(" line687="            MICROBIT_LABCODE_ULTRASONIC_OBJECT_DETECTED_ID," line688="            travelTimeThreshold," line689="            () =&gt; {" line690="                handler();" line691="            }" line692="        );" line693="    }" line694="" line695="    //% subcategory=&quot;Ultrassônico&quot;" line696="    //% group=&quot;Ultrassônico&quot;" line697="    //% blockId=&quot;labcode_ultrasonic_distance&quot;" line698="    //% block=&quot;A distância é %unit&quot;" line699="    //% weight=60 color=#000080" line700="    export function getUltrasonicDistance(unit: DistanceUnit): number {" line701="        if (!ultrasonicState) return -1;" line702="        basic.pause(0);" line703="        return Math.idiv(ultrasonicState.medianRoundTrip, unit);" line704="    }" line705="" line706="    //% subcategory=&quot;Ultrassônico&quot;" line707="    //% group=&quot;Ultrassônico&quot;" line708="    //% blockId=&quot;labcode_ultrasonic_less_than&quot;" line709="    //% block=&quot;A distância é menor que | %distance | %unit&quot;" line710="    //% weight=50 color=#000080" line711="    export function isUltrasonicDistanceLessThan(distance: number, unit: DistanceUnit): boolean {" line712="        if (!ultrasonicState) return false;" line713="        basic.pause(0);" line714="        return Math.idiv(ultrasonicState.medianRoundTrip, unit) &lt; distance;" line715="    }" line716="" line717="    function triggerPulse() {" line718="        pins.setPull(ultrasonicState.trig, PinPullMode.PullNone);" line719="        pins.digitalWritePin(ultrasonicState.trig, 0);" line720="        control.waitMicros(2);" line721="" line722="        pins.digitalWritePin(ultrasonicState.trig, 1);" line723="        control.waitMicros(10);" line724="        pins.digitalWritePin(ultrasonicState.trig, 0);" line725="    }" line726="" line727="    function getMedianRRT(roundTrips: UltrasonicRoundTrip[]) {" line728="        const roundTripTimes = roundTrips.map((urt) =&gt; urt.rtt);" line729="        return median(roundTripTimes);" line730="    }" line731="" line732="    function median(values: number[]) {" line733="        values.sort((a, b) =&gt; a - b);" line734="        return values[(values.length - 1) &gt;&gt; 1];" line735="    }" line736="" line737="    function measureInBackground() {" line738="        const trips = ultrasonicState.roundTrips;" line739="        const TIME_BETWEEN_PULSE_MS = 145;" line740="" line741="        while (true) {" line742="            const now = input.runningTime();" line743="" line744="            if (trips[trips.length - 1].ts &lt; now - TIME_BETWEEN_PULSE_MS - 10) {" line745="                ultrasonicState.roundTrips.push({" line746="                    ts: now," line747="                    rtt: MAX_ULTRASONIC_TRAVEL_TIME," line748="                });" line749="            }" line750="" line751="            while (trips.length &gt; ULTRASONIC_MEASUREMENTS) {" line752="                trips.shift();" line753="            }" line754="" line755="            ultrasonicState.medianRoundTrip = getMedianRRT(ultrasonicState.roundTrips);" line756="" line757="            for (let i = 0; i &lt; ultrasonicState.travelTimeObservers.length; i++) {" line758="                const threshold = ultrasonicState.travelTimeObservers[i];" line759="                if (threshold &gt; 0 &amp;&amp; ultrasonicState.medianRoundTrip &lt;= threshold) {" line760="                    control.raiseEvent(" line761="                        MICROBIT_LABCODE_ULTRASONIC_OBJECT_DETECTED_ID," line762="                        threshold" line763="                    );" line764="                    ultrasonicState.travelTimeObservers[i] = -threshold;" line765="                } else if (" line766="                    threshold &lt; 0 &amp;&amp;" line767="                    ultrasonicState.medianRoundTrip &gt; -threshold" line768="                ) {" line769="                    ultrasonicState.travelTimeObservers[i] = -threshold;" line770="                }" line771="            }" line772="" line773="            triggerPulse();" line774="            basic.pause(TIME_BETWEEN_PULSE_MS);" line775="        }" line776="    }" line777="" line778="    // ==========================================" line779="    // SUBCATEGORIA: SEGUIDOR DE LINHA" line780="    // ==========================================" line781="" line782="    //% subcategory=&quot;Seguidor de Linha&quot;" line783="    //% blockId=sed_line_finder " line784="    //% block=&quot;pino |%pin| seguidor de linha detecta preto. Inverter ação |$reverseAction|&quot;" line785="    //% reverseAction.shadow=&quot;toggleOnOff&quot; color=#000080" line786="    export function lineFinder(pin: DigitalPin, reverseAction?: boolean): boolean {" line787="        if (reverseAction) {" line788="            return pins.digitalReadPin(pin) == 0;" line789="        } else {" line790="            return pins.digitalReadPin(pin) == 1;" line791="        }" line792="    }" line793="" line794="    //% subcategory=&quot;Seguidor de Linha&quot;" line795="    //% block=&quot;sensor Digital de Linha |%Sensor| pino |%pin|&quot;" line796="    //% group=&quot;Sensores de linha&quot; color=#000080" line797="    export function detectline(sensor: Sensor, pin: DigitalPin): number {" line798="        if (sensor == Sensor.Esquerdo || sensor == Sensor.Centro || sensor == Sensor.Direito) {" line799="            return pins.digitalReadPin(pin);" line800="        } else {" line801="            return -1;" line802="        }" line803="    }" line804="" line805="    //% subcategory=&quot;Seguidor de Linha&quot;" line806="    //% block=&quot;Sensor Analógico de Linha |%Sensor| pino |%pin|&quot;" line807="    //% group=&quot;Sensores de linha&quot; color=#000080" line808="    export function detecetlinha(sensor: Sensor, pin: AnalogPin): number {" line809="        if (sensor == Sensor.Esquerdo || sensor == Sensor.Centro || sensor == Sensor.Direito) {" line810="            return pins.analogReadPin(pin);" line811="        } else {" line812="            return -1;" line813="        }" line814="    }" line815="" line816="    //% subcategory=&quot;Seguidor de Linha&quot;" line817="    //% blockId=&quot;umsensor&quot; block=&quot;Detecção do sensor de linha Digital (p1) %Umsensor&quot;" line818="    //% group=&quot;Sensores de linha V.2( pinos: P0,  P1 e ou  P2 Cores: Branco: ▮ e Preto: ▯)&quot; color=#000080" line819="    export function readUm(um: Um_sensor): boolean {" line820="        if (um == Um_sensor.branco) {" line821="            return pins.digitalReadPin(DigitalPin.P1) == 0;" line822="        } else if (um == Um_sensor.preto) {" line823="            return pins.digitalReadPin(DigitalPin.P1) == 1;" line824="        }" line825="        return true;" line826="    }" line827="" line828="    //% subcategory=&quot;Seguidor de Linha&quot;" line829="    //% blockId=&quot;doissensores&quot; block=&quot;Detecção dos sensores(P1 e P2) de linha Digital %Doissensores&quot;" line830="    //% group=&quot;Sensores de linha V.2( pinos: P0,  P1 e ou  P2 Cores: Branco: ▮ e Preto: ▯)&quot; color=#000080" line831="    export function readDois(dois: Dois_sensores): boolean {" line832="        let p1 = pins.digitalReadPin(DigitalPin.P1);" line833="        let p2 = pins.digitalReadPin(DigitalPin.P2);" line834="" line835="        if (dois == Dois_sensores.branco_branco) return p1 == 0 &amp;&amp; p2 == 0;" line836="        if (dois == Dois_sensores.branco_preto) return p1 == 0 &amp;&amp; p2 == 1;" line837="        if (dois == Dois_sensores.preto_branco) return p1 == 1 &amp;&amp; p2 == 0;" line838="        if (dois == Dois_sensores.preto_preto) return p1 == 1 &amp;&amp; p2 == 1;" line839="        return true;" line840="    }" line841="" line842="    //% subcategory=&quot;Seguidor de Linha&quot;" line843="    //% blockId=&quot;tresssensores&quot; block=&quot;Detecção dos sensores de linha Digital %Tressensores&quot;" line844="    //% group=&quot;Sensores de linha V.2( pinos: P0,  P1 e ou  P2 Cores: Branco: ▮ e Preto: ▯)&quot; color=#000080" line845="    export function readtres(tres: Tres_sensores): boolean {" line846="        let p0 = pins.digitalReadPin(DigitalPin.P0);" line847="        let p12 = pins.digitalReadPin(DigitalPin.P1);" line848="        let p22 = pins.digitalReadPin(DigitalPin.P2);" line849="" line850="        if (tres == Tres_sensores.branco_branco_branco) return p0 == 0 &amp;&amp; p12 == 0 &amp;&amp; p22 == 0;" line851="        if (tres == Tres_sensores.branco_branco_preto) return p0 == 0 &amp;&amp; p12 == 0 &amp;&amp; p22 == 1;" line852="        if (tres == Tres_sensores.branco_preto_branco) return p0 == 0 &amp;&amp; p12 == 1 &amp;&amp; p22 == 0;" line853="        if (tres == Tres_sensores.preto_branco_branco) return p0 == 1 &amp;&amp; p12 == 0 &amp;&amp; p22 == 0;" line854="        if (tres == Tres_sensores.preto_preto_branco) return p0 == 1 &amp;&amp; p12 == 1 &amp;&amp; p22 == 0;" line855="        if (tres == Tres_sensores.branco_preto_preto) return p0 == 0 &amp;&amp; p12 == 1 &amp;&amp; p22 == 1;" line856="        if (tres == Tres_sensores.preto_branco_preto) return p0 == 1 &amp;&amp; p12 == 0 &amp;&amp; p22 == 1;" line857="        if (tres == Tres_sensores.preto_preto_preto) return p0 == 1 &amp;&amp; p12 == 1 &amp;&amp; p22 == 1;" line858="        return true;" line859="    }" line860="" line861="    //% subcategory=&quot;Seguidor de Linha&quot;" line862="    //% blockId=&quot;umasensor&quot; block=&quot;Detecção do sensor de linha Analógica (P1) %Umsensor | Média = %m&quot;" line863="    //% group=&quot;Sensores de linha V.2( pinos: P0,  P1 e ou  P2 Cores: Branco: ▮ e Preto: ▯)&quot;" line864="    //% m.min=0 m.max=1023 color=#000080" line865="    export function readUma(uma: Um_sensor, m: number): boolean {" line866="        let p13 = pins.analogReadPin(AnalogPin.P1);" line867="        if (uma == Um_sensor.branco) return p13 &lt; m;" line868="        if (uma == Um_sensor.preto) return p13 &gt; m;" line869="        return true;" line870="    }" line871="" line872="    //% subcategory=&quot;Seguidor de Linha&quot;" line873="    //% blockId=&quot;doissensoresa&quot; block=&quot;Detecção dos sensores(P1 e P2) de linha Analógica %Doissensores | Média = %m&quot;" line874="    //% group=&quot;Sensores de linha V.2( pinos: P0,  P1 e ou  P2 Cores: Branco: ▮ e Preto: ▯)&quot;" line875="    //% m.min=0 m.max=1023 color=#000080" line876="    export function readDoisa(doisa: Dois_sensores, m: number): boolean {" line877="        let p14 = pins.analogReadPin(AnalogPin.P1);" line878="        let p23 = pins.analogReadPin(AnalogPin.P2);" line879="" line880="        if (doisa == Dois_sensores.branco_branco) return p14 &lt; m &amp;&amp; p23 &lt; m;" line881="        if (doisa == Dois_sensores.branco_preto) return p14 &lt; m &amp;&amp; p23 &gt; m;" line882="        if (doisa == Dois_sensores.preto_branco) return p14 &gt; m &amp;&amp; p23 &lt; m;" line883="        if (doisa == Dois_sensores.preto_preto) return p14 &gt; m &amp;&amp; p23 &gt; m;" line884="        return true;" line885="    }" line886="" line887="    //% subcategory=&quot;Seguidor de Linha&quot;" line888="    //% blockId=&quot;tresssensoresa&quot; block=&quot;Detecção dos sensores de linha Analógica %Tressensores| Média = %m&quot;" line889="    //% group=&quot;Sensores de linha V.2( pinos: P0,  P1 e ou  P2 Cores: Branco: ▮ e Preto: ▯)&quot;" line890="    //% m.min=0 m.max=1023 color=#000080" line891="    export function readtresa(tresa: Tres_sensores, m: number): boolean {" line892="        let p02 = pins.analogReadPin(AnalogPin.P0);" line893="        let p15 = pins.analogReadPin(AnalogPin.P1);" line894="        let p24 = pins.analogReadPin(AnalogPin.P2);" line895="" line896="        if (tresa == Tres_sensores.branco_branco_branco) return p02 &lt; m &amp;&amp; p15 &lt; m &amp;&amp; p24 &lt; m;" line897="        if (tresa == Tres_sensores.branco_branco_preto) return p02 &lt; m &amp;&amp; p15 &lt; m &amp;&amp; p24 &gt; m;" line898="        if (tresa == Tres_sensores.branco_preto_branco) return p02 &lt; m &amp;&amp; p15 &gt; m &amp;&amp; p24 &lt; m;" line899="        if (tresa == Tres_sensores.preto_branco_branco) return p02 &gt; m &amp;&amp; p15 &lt; m &amp;&amp; p24 &lt; m;" line900="        if (tresa == Tres_sensores.preto_preto_branco) return p02 &gt; m &amp;&amp; p15 &gt; m &amp;&amp; p24 &lt; m;" line901="        if (tresa == Tres_sensores.branco_preto_preto) return p02 &lt; m &amp;&amp; p15 &gt; m &amp;&amp; p24 &gt; m;" line902="        if (tresa == Tres_sensores.preto_branco_preto) return p02 &gt; m &amp;&amp; p15 &lt; m &amp;&amp; p24 &gt; m;" line903="        if (tresa == Tres_sensores.preto_preto_preto) return p02 &gt; m &amp;&amp; p15 &gt; m &amp;&amp; p24 &gt; m;" line904="        return true;" line905="    }" line906="" line907="    //% subcategory=&quot;Seguidor de Linha&quot;" line908="    //% blockId=&quot;doissensoresam&quot; block=&quot;Detecção dos sensores(P1 e P2) de linha Analógica %Doissensores | Média 1 = %m1| Média 2 = %m2&quot;" line909="    //% group=&quot;Sensores de linha V.2( pinos: P0,  P1 e ou  P2 Cores: Branco: ▮ e Preto: ▯)&quot;" line910="    //% m1.min=0 m1.max=1023 m2.min=0 m2.max=1023 color=#000080" line911="    export function readDoisam(doisa: Dois_sensores, m1: number, m2: number): boolean {" line912="        let p16 = pins.analogReadPin(AnalogPin.P1);" line913="        let p25 = pins.analogReadPin(AnalogPin.P2);" line914="" line915="        if (doisa == Dois_sensores.branco_branco) return p16 &lt; m1 &amp;&amp; p25 &lt; m2;" line916="        if (doisa == Dois_sensores.branco_preto) return p16 &lt; m1 &amp;&amp; p25 &gt; m2;" line917="        if (doisa == Dois_sensores.preto_branco) return p16 &gt; m1 &amp;&amp; p25 &lt; m2;" line918="        if (doisa == Dois_sensores.preto_preto) return p16 &gt; m1 &amp;&amp; p25 &gt; m2;" line919="        return true;" line920="    }" line921="" line922="    // ==========================================" line923="    // SUBCATEGORIA: SENSORES DIGITAIS" line924="    // ==========================================" line925="" line926="    //% subcategory=&quot;Sensores Digitais&quot;" line927="    //% blockId=sed_collision " line928="    //% block=&quot;sensor de colisão pino |%pin| ativado&quot;" line929="    //% color=#000080" line930="    export function collisionButton(pin: DigitalPin): boolean {" line931="        return pins.digitalReadPin(pin) == 0;" line932="    }" line933="" line934="    //% subcategory=&quot;Sensores Digitais&quot;" line935="    //% blockId=sed_water " line936="    //% block=&quot;sensor de água pino |%pin| detecta água&quot;" line937="    //% color=#000080" line938="    export function waterSensor(pin: DigitalPin): boolean {" line939="        return pins.digitalReadPin(pin) == 1;" line940="    }" line941="" line942="    //% subcategory=&quot;Sensores Digitais&quot;" line943="    //% blockId=sed_magnetic " line944="    //% block=&quot;chave magnética pino |%pin| ativada&quot;" line945="    //% color=#000080" line946="    export function magneticSwitch(pin: DigitalPin): boolean {" line947="        return pins.digitalReadPin(pin) == 0;" line948="    }" line949="" line950="    //% subcategory=&quot;Sensores Digitais&quot;" line951="    //% blockId=sed_hall " line952="    //% block=&quot;sensor hall pino |%pin| ativado&quot;" line953="    //% color=#000080" line954="    export function hallSensor(pin: DigitalPin): boolean {" line955="        return pins.digitalReadPin(pin) == 0;" line956="    }" line957="" line958="    //% subcategory=&quot;Sensores Digitais&quot;" line959="    //% blockId=sed_crash " line960="    //% block=&quot;sensor de impacto |%pin| pressionado&quot;" line961="    //% color=#000080" line962="    export function crashButton(pin: DigitalPin): boolean {" line963="        return pins.digitalReadPin(pin) == 0;" line964="    }" line965="" line966="    //% subcategory=&quot;Sensores Digitais&quot;" line967="    //% blockId=sed_flame " line968="    //% block=&quot;sensor de chama pino |%pin| detecta fogo&quot;" line969="    //% color=#000080" line970="    export function flameSensor(pin: DigitalPin): boolean {" line971="        return pins.digitalReadPin(pin) == 0;" line972="    }" line973="" line974="    //% subcategory=&quot;Sensores Digitais&quot;" line975="    //% blockId=sed_touch " line976="    //% block=&quot;sensor de toque pino |%pin| tocado&quot;" line977="    //% color=#000080" line978="    export function touchSensor(pin: DigitalPin): boolean {" line979="        return pins.digitalReadPin(pin) == 1;" line980="    }" line981="" line982="    //% subcategory=&quot;Sensores Digitais&quot;" line983="    //% blockId=sed_vibration " line984="    //% block=&quot;sensor de vibração pino |%pin| detecta vibração&quot;" line985="    //% color=#000080" line986="    export function vibrationSensor(pin: DigitalPin): boolean {" line987="        return pins.digitalReadPin(pin) == 1;" line988="    }" line989="" line990="    //% subcategory=&quot;Sensores Digitais&quot;" line991="    //% blockId=sed_pir " line992="    //% block=&quot;sensor PIR pino |%pin| detecta movimento&quot;" line993="    //% color=#000080" line994="    export function pirSensor(pin: DigitalPin): boolean {" line995="        return pins.digitalReadPin(pin) == 1;" line996="    }" line997="" line998="    // ==========================================" line999="    // SUBCATEGORIA: SENSORES ANALÓGICOS" line1000="    // ==========================================" line1001="" line1002="    //% subcategory=&quot;Sensores Analógicos&quot;" line1003="    //% blockId=sed_raindrop " line1004="    //% block=&quot;valor do sensor de chuva (0~100) no pino %raindroppin. Intervalo (leitura) min|%vmin| máx|%vmax|&quot;" line1005="    //% vmin.defl=0 vmax.defl=1023" line1006="    //% color=#000080" line1007="    export function raindropSensor(raindroppin: AnalogPin, vmin: number = 0, vmax: number = 1023): number {" line1008="        let value = pins.analogReadPin(raindroppin);" line1009="        let rain = Math.map(value, vmin, vmax, 0, 100);" line1010="        return Math.round(rain);" line1011="    }" line1012="" line1013="    //% subcategory=&quot;Sensores Analógicos&quot;" line1014="    //% blockId=sed_capacitivesoilhumidity " line1015="    //% block=&quot;valor da umidade do solo (0~100) no pino %capacitivesoilhumiditypin. Intervalo (leitura) min|%vmin| máx|%vmax|&quot;" line1016="    //% vmin.defl=200 vmax.defl=1023" line1017="    //% color=#000080" line1018="    export function capacitiveSoilHumiditySensor(capacitivesoilhumiditypin: AnalogPin, vmin: number = 200, vmax: number = 1023): number {" line1019="        let value2 = pins.analogReadPin(capacitivesoilhumiditypin);" line1020="        let humidity = Math.map(value2, vmin, vmax, 100, 0);" line1021="        return Math.round(humidity);" line1022="    }" line1023="" line1024="    //% subcategory=&quot;Sensores Analógicos&quot;" line1025="    //% blockId=sed_soilhumidity " line1026="    //% block=&quot;valor da umidade do solo (0~100) no pino %soilhumiditypin&quot;" line1027="    //% color=#000080" line1028="    export function soilHumiditySensor(soilhumiditypin: AnalogPin): number {" line1029="        let value3 = pins.analogReadPin(soilhumiditypin);" line1030="        let humidity2 = Math.map(value3, 0, 1000, 0, 100);" line1031="        return Math.round(humidity2);" line1032="    }" line1033="" line1034="    //% subcategory=&quot;Sensores Analógicos&quot;" line1035="    //% blockId=sed_lightintensity " line1036="    //% block=&quot;valor da intensidade de luz (0~100) no pino %lightintensitypin&quot;" line1037="    //% color=#000080" line1038="    export function lightIntensitySensor(lightintensitypin: AnalogPin): number {" line1039="        let value4 = pins.analogReadPin(lightintensitypin);" line1040="        let light = Math.map(value4, 0, 750, 0, 100);" line1041="        return Math.round(light);" line1042="    }" line1043="" line1044="    //% subcategory=&quot;Sensores Analógicos&quot;" line1045="    //% blockId=sed_uvlevel " line1046="    //% block=&quot;sensor UV (0~15) no pino %uvlevelpin&quot;" line1047="    //% color=#000080" line1048="    export function uvLevelSensor(uvlevelpin: AnalogPin): number {" line1049="        let value5 = pins.analogReadPin(uvlevelpin);" line1050="        let uv = Math.map(value5, 0, 1023, 0, 15);" line1051="        return Math.round(uv);" line1052="    }" line1053="" line1054="    //% subcategory=&quot;Sensores Analógicos&quot;" line1055="    //% blockId=sed_temperature " line1056="    //% block=&quot;valor da temperatura (Celsius) no pino %temperaturepin&quot;" line1057="    //% color=#000080" line1058="    export function temperatureSensor(temperaturepin: AnalogPin): number {" line1059="        let B = 4275;" line1060="        let value6 = pins.analogReadPin(temperaturepin);" line1061="        let R = 1023 / value6 - 1.0;" line1062="        R = 100000 * R;" line1063="        let temperature = 1.0 / (Math.log(R / 100000) / B + 1 / 298.15) - 273.15;" line1064="        return Math.round(temperature);" line1065="    }" line1066="" line1067="    //% subcategory=&quot;Sensores Analógicos&quot;" line1068="    //% blockId=sed_gas " line1069="    //% block=&quot;sensor de gás %sensor no pino %gaspin valor de concentração&quot;" line1070="    //% color=#000080" line1071="    export function gasSensor(sensor: GasList, gaspin: AnalogPin): number {" line1072="        let value7 = pins.analogReadPin(gaspin);" line1073="        let gas = Math.map(value7, 0, 1023, 0, 100);" line1074="        return Math.round(gas);" line1075="    }" line1076="" line1077="    //% subcategory=&quot;Sensores Analógicos&quot;" line1078="    //% blockId=sed_noise " line1079="    //% block=&quot;valor do ruído (dB) no pino %noisepin (0~100)&quot;" line1080="    //% color=#000080" line1081="    export function noiseSensor(noisepin: AnalogPin): number {" line1082="        let value8 = pins.analogReadPin(noisepin);" line1083="        let noise = Math.map(value8, 0, 1023, 0, 100);" line1084="        return Math.round(noise);" line1085="    }" line1086="" line1087="    // ==========================================" line1088="    // SUBCATEGORIA: COR E GESTOS (I2C)" line1089="    // ==========================================" line1090="" line1091="    //% subcategory=&quot;Cor e Gestos&quot;" line1092="    //% blockId=sed_colorsensor " line1093="    //% block=&quot;sensor de cor detectou %Color&quot;" line1094="    //% color=#000080" line1095="    export function colorSensor(Color: Color): boolean {" line1096="        return false;" line1097="    }" line1098="" line1099="    //% subcategory=&quot;Cor e Gestos&quot;" line1100="    //% blockId=sed_apds9960_hue " line1101="    //% block=&quot;APDS9960 obter matiz da cor HUE (0~360)&quot;" line1102="    //% color=#000080" line1103="    export function getHue(): number {" line1104="        return 0;" line1105="    }" line1106="" line1107="    //% subcategory=&quot;Cor e Gestos&quot;" line1108="    //% blockId=sed_apds9960_check_color " line1109="    //% block=&quot;sensor de cor APDS9960 detecta %color&quot;" line1110="    //% color=#000080" line1111="    export function checkColor(color: ColorList): boolean {" line1112="        let hue = getHue();" line1113="        switch (color) {" line1114="            case ColorList.red:" line1115="                return (hue &gt;= 330 || hue &lt; 20);" line1116="            case ColorList.yellow:" line1117="                return (hue &gt;= 20 &amp;&amp; hue &lt; 75);" line1118="            case ColorList.green:" line1119="                return (hue &gt;= 75 &amp;&amp; hue &lt; 165);" line1120="            case ColorList.cyan:" line1121="                return (hue &gt;= 165 &amp;&amp; hue &lt; 210);" line1122="            case ColorList.blue:" line1123="                return (hue &gt;= 210 &amp;&amp; hue &lt; 270);" line1124="            case ColorList.magenta:" line1125="                return (hue &gt;= 270 &amp;&amp; hue &lt; 330);" line1126="            case ColorList.white:" line1127="                return true;" line1128="            default:" line1129="                return false;" line1130="        }" line1131="    }" line1132="" line1133="    // ==========================================" line1134="    // SUBCATEGORIA: LCD DISPLAY" line1135="    // ==========================================" line1136="" line1137="    const enum Lcd { Command = 0, Data = 1 }" line1138="" line1139="    interface LcdState {" line1140="        i2cAddress: uint8;" line1141="        backlight: LcdBacklight;" line1142="        characters: Buffer;" line1143="        rows: uint8;" line1144="        columns: uint8;" line1145="        lineNeedsUpdate: uint8;" line1146="        refreshIntervalId: number;" line1147="    }" line1148="" line1149="    let lcdState: LcdState = undefined;" line1150="" line1151="    function connect(): boolean {" line1152="        if (0 != pins.i2cReadNumber(39, NumberFormat.Int8LE, false)) {" line1153="            connectLcd(39);" line1154="        } else if (0 != pins.i2cReadNumber(63, NumberFormat.Int8LE, false)) {" line1155="            connectLcd(63);" line1156="        }" line1157="        return !!lcdState;" line1158="    }" line1159="" line1160="    function write4bits(value: number) {" line1161="        if (!lcdState &amp;&amp; !connect()) return;" line1162="        pins.i2cWriteNumber(lcdState.i2cAddress, value, NumberFormat.Int8LE);" line1163="        pins.i2cWriteNumber(lcdState.i2cAddress, value | 0x04, NumberFormat.Int8LE);" line1164="        control.waitMicros(1);" line1165="        pins.i2cWriteNumber(lcdState.i2cAddress, value &amp; (0xff ^ 0x04), NumberFormat.Int8LE);" line1166="        control.waitMicros(50);" line1167="    }" line1168="" line1169="    function send(RS_bit: number, payload: number) {" line1170="        if (!lcdState) return;" line1171="        const highnib = payload &amp; 0xf0;" line1172="        write4bits(highnib | lcdState.backlight | RS_bit);" line1173="        const lownib = (payload &lt;&lt; 4) &amp; 0xf0;" line1174="        write4bits(lownib | lcdState.backlight | RS_bit);" line1175="    }" line1176="" line1177="    function sendCommand(command: number) { send(Lcd.Command, command); }" line1178="    function sendData(data: number) { send(Lcd.Data, data); }" line1179="" line1180="    function setCursor(line: number, column: number) {" line1181="        const offsets = [0x00, 0x40, 0x14, 0x54];" line1182="        sendCommand(0x80 | (offsets[line] + column));" line1183="    }" line1184="" line1185="    function updateCharacterBuffer(" line1186="        text: string," line1187="        offset: number," line1188="        length: number," line1189="        columns: number," line1190="        rows: number," line1191="        alignment: TextAlignment," line1192="        pad: string" line1193="    ): void {" line1194="        if (!lcdState &amp;&amp; !connect()) return;" line1195="" line1196="        if (!lcdState.refreshIntervalId) {" line1197="            lcdState.refreshIntervalId = control.setInterval(refreshDisplay, 500, control.IntervalMode.Timeout);" line1198="        }" line1199="" line1200="        if (lcdState.columns === 0) {" line1201="            lcdState.columns = columns;" line1202="            lcdState.rows = rows;" line1203="            lcdState.characters = pins.createBuffer(lcdState.rows * lcdState.columns);" line1204="" line1205="            const whitespace = &quot;x&quot;.charCodeAt(0);" line1206="            for (let pos = 0; pos &lt; lcdState.rows * lcdState.columns; pos++) {" line1207="                lcdState.characters[pos] = whitespace;" line1208="            }" line1209="            updateCharacterBuffer(&quot;&quot;, 0, lcdState.columns * lcdState.rows, lcdState.columns, lcdState.rows, TextAlignment.Left, &quot; &quot;);" line1210="        }" line1211="" line1212="        if (columns !== lcdState.columns || rows !== lcdState.rows) return;" line1213="" line1214="        const fillCharacter = pad.length &gt; 0 ? pad.charCodeAt(0) : &quot; &quot;.charCodeAt(0);" line1215="        let endPosition = offset + length;" line1216="        if (endPosition &gt; lcdState.columns * lcdState.rows) {" line1217="            endPosition = lcdState.columns * lcdState.rows;" line1218="        }" line1219="        let lcdPos = offset;" line1220="" line1221="        if (alignment == TextAlignment.Right) {" line1222="            while (lcdPos &lt; endPosition - text.length) {" line1223="                if (lcdState.characters[lcdPos] != fillCharacter) {" line1224="                    lcdState.characters[lcdPos] = fillCharacter;" line1225="                    lcdState.lineNeedsUpdate |= (1 &lt;&lt; Math.idiv(lcdPos, lcdState.columns));" line1226="                }" line1227="                lcdPos++;" line1228="            }" line1229="        }" line1230="" line1231="        let textPosition = 0;" line1232="        while (lcdPos &lt; endPosition &amp;&amp; textPosition &lt; text.length) {" line1233="            if (lcdState.characters[lcdPos] != text.charCodeAt(textPosition)) {" line1234="                lcdState.characters[lcdPos] = text.charCodeAt(textPosition);" line1235="                lcdState.lineNeedsUpdate |= (1 &lt;&lt; Math.idiv(lcdPos, lcdState.columns));" line1236="            }" line1237="            lcdPos++;" line1238="            textPosition++;" line1239="        }" line1240="" line1241="        while (lcdPos &lt; endPosition) {" line1242="            if (lcdState.characters[lcdPos] != fillCharacter) {" line1243="                lcdState.characters[lcdPos] = fillCharacter;" line1244="                lcdState.lineNeedsUpdate |= (1 &lt;&lt; Math.idiv(lcdPos, lcdState.columns));" line1245="            }" line1246="            lcdPos++;" line1247="        }" line1248="    }" line1249="" line1250="    function sendLine(line: number): void {" line1251="        setCursor(line, 0);" line1252="        for (let position = lcdState.columns * line; position &lt; lcdState.columns * (line + 1); position++) {" line1253="            sendData(lcdState.characters[position]);" line1254="        }" line1255="    }" line1256="" line1257="    function refreshDisplay() {" line1258="        if (!lcdState) return;" line1259="        lcdState.refreshIntervalId = undefined;" line1260="        for (let j = 0; j &lt; lcdState.rows; j++) {" line1261="            if (lcdState.lineNeedsUpdate &amp; (1 &lt;&lt; j)) {" line1262="                lcdState.lineNeedsUpdate &amp;= ~(1 &lt;&lt; j);" line1263="                sendLine(j);" line1264="            }" line1265="        }" line1266="    }" line1267="" line1268="    function toAlignment(option?: TextOption): TextAlignment {" line1269="        return (option === TextOption.AlignRight || option === TextOption.PadWithZeros) ? TextAlignment.Right : TextAlignment.Left;" line1270="    }" line1271="" line1272="    function toPad(option?: TextOption): string {" line1273="        return option === TextOption.PadWithZeros ? &quot;0&quot; : &quot; &quot;;" line1274="    }" line1275="" line1276="    //% subcategory=&quot;LCD&quot;" line1277="    //% blockId=&quot;sed_lcd_show_string_on_1602&quot;" line1278="    //% block=&quot;LCD1602 exibir %text | na posição %startPosition=sed_lcd_position_1602 com tamanho %length || e %option&quot;" line1279="    //% text.shadowOptions.toString=true " line1280="    //% length.min=1 length.max=32 length.fieldOptions.precision=1" line1281="    //% expandableArgumentMode=&quot;toggle&quot;" line1282="    //% inlineInputMode=&quot;inline&quot;" line1283="    //% weight=90 color=#000080" line1284="    export function showStringOnLcd1602(text: string, startPosition: number, length: number, option?: TextOption): void {" line1285="        updateCharacterBuffer(text, startPosition - 1, length, 16, 2, toAlignment(option), toPad(option));" line1286="    }" line1287="" line1288="    //% subcategory=&quot;LCD&quot;" line1289="    //% blockId=&quot;sed_lcd_clear_1602&quot; block=&quot;LCD1602 limpar tela&quot;" line1290="    //% weight=89 color=#000080" line1291="    export function clearLcd1602(): void {" line1292="        showStringOnLcd1602(&quot;&quot;, 1, 32);" line1293="    }" line1294="" line1295="    //% subcategory=&quot;LCD&quot;" line1296="    //% blockId=&quot;sed_lcd_show_string_on_2004&quot;" line1297="    //% block=&quot;LCD2004 exibir %text | na posição %startPosition=sed_lcd_position_2004 com tamanho %length || e %option&quot;" line1298="    //% text.shadowOptions.toString=true" line1299="    //% length.min=1 length.max=80 length.fieldOptions.precision=1" line1300="    //% expandableArgumentMode=&quot;toggle&quot;" line1301="    //% inlineInputMode=&quot;inline&quot;" line1302="    //% weight=80 color=#000080" line1303="    export function showStringOnLcd2004(text: string, startPosition: number, length: number, option?: TextOption): void {" line1304="        updateCharacterBuffer(text, startPosition - 1, length, 20, 4, toAlignment(option), toPad(option));" line1305="    }" line1306="" line1307="    //% subcategory=&quot;LCD&quot;" line1308="    //% blockId=&quot;sed_lcd_clear_2004&quot; block=&quot;LCD2004 limpar tela&quot;" line1309="    //% weight=79 color=#000080" line1310="    export function clearLcd2004(): void {" line1311="        showStringOnLcd2004(&quot;&quot;, 1, 80);" line1312="    }" line1313="" line1314="    //% subcategory=&quot;LCD&quot;" line1315="    //% blockId=sed_lcd_position_1602" line1316="    //% block=&quot;%pos&quot;" line1317="    //% pos.fieldEditor=&quot;gridpicker&quot;" line1318="    //% pos.fieldOptions.columns=16" line1319="    //% blockHidden=true color=#000080" line1320="    export function position1602(pos: LcdPosition1602): number {" line1321="        return pos;" line1322="    }" line1323="" line1324="    //% subcategory=&quot;LCD&quot;" line1325="    //% blockId=sed_lcd_position_2004" line1326="    //% block=&quot;%pos&quot;" line1327="    //% pos.fieldEditor=&quot;gridpicker&quot;" line1328="    //% pos.fieldOptions.columns=20" line1329="    //% blockHidden=true color=#000080" line1330="    export function position2004(pos: LcdPosition2004): number {" line1331="        return pos;" line1332="    }" line1333="" line1334="    //% subcategory=&quot;LCD&quot;" line1335="    //% blockId=&quot;sed_lcd_backlight&quot; block=&quot;alternar luz de fundo do LCD %backlight&quot;" line1336="    //% backlight.fieldEditor=&quot;gridpicker&quot;" line1337="    //% backlight.fieldOptions.columns=2" line1338="    //% weight=79 color=#000080" line1339="    export function setLcdBacklight(backlight: LcdBacklight): void {" line1340="        if (!lcdState &amp;&amp; !connect()) return;" line1341="        lcdState.backlight = backlight;" line1342="        send(Lcd.Command, 0);" line1343="    }" line1344="" line1345="    //% subcategory=&quot;LCD&quot;" line1346="    //% blockId=&quot;sed_lcd_set_address&quot; block=&quot;conectar LCD no endereço I2C %i2cAddress&quot;" line1347="    //% i2cAddress.min=0 i2cAddress.max=127" line1348="    //% weight=70 color=#000080" line1349="    export function connectLcd(i2cAddress: number): void {" line1350="        if (lcdState &amp;&amp; lcdState.i2cAddress == i2cAddress) return;" line1351="        if (0 === pins.i2cReadNumber(i2cAddress, NumberFormat.Int8LE, false)) return;" line1352="" line1353="        if (lcdState &amp;&amp; lcdState.refreshIntervalId) {" line1354="            control.clearInterval(lcdState.refreshIntervalId, control.IntervalMode.Timeout);" line1355="            lcdState.refreshIntervalId = undefined;" line1356="        }" line1357="" line1358="        lcdState = {" line1359="            i2cAddress: i2cAddress," line1360="            backlight: LcdBacklight.On," line1361="            columns: 0," line1362="            rows: 0," line1363="            characters: undefined," line1364="            lineNeedsUpdate: 0," line1365="            refreshIntervalId: undefined," line1366="        };" line1367="" line1368="        basic.pause(50);" line1369="        pins.i2cWriteNumber(lcdState.i2cAddress, lcdState.backlight, NumberFormat.Int8LE);" line1370="        basic.pause(50);" line1371="" line1372="        write4bits(0x30);" line1373="        control.waitMicros(4100);" line1374="        write4bits(0x30);" line1375="        control.waitMicros(4100);" line1376="        write4bits(0x30);" line1377="        control.waitMicros(4100);" line1378="        write4bits(0x20);" line1379="        control.waitMicros(1000);" line1380="" line1381="        send(Lcd.Command, 0x20 | 0x00 | 0x08 | 0x00);" line1382="        control.waitMicros(1000);" line1383="        send(Lcd.Command, 0x08 | 0x04 | 0x00 | 0x00);" line1384="        control.waitMicros(1000);" line1385="        send(Lcd.Command, 0x04 | 0x02 | 0x00);" line1386="        control.waitMicros(1000);" line1387="    }" line1388="" line1389="    //% subcategory=&quot;LCD&quot;" line1390="    //% blockId=&quot;sed_lcd_is_connected&quot; block=&quot;LCD está conectado&quot;" line1391="    //% weight=69 color=#000080" line1392="    export function isLcdConnected(): boolean {" line1393="        return !!lcdState || connect();" line1394="    }" line1395="}" numlines="1396"></mutation></block></statement></block></xml>