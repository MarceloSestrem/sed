<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="4)(.1/}GlgHQyfJ15XVJ" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="]w:I#YX5=3JNE3_%OAP!"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace SED {" line1="" line2="    // --- ENUMERAÇÕES ---" line3="" line4="    export enum PingUnit {" line5="        //% block=&quot;cm&quot;" line6="        cm," line7="        //% block=&quot;polegadas&quot;" line8="        inch," line9="        //% block=&quot;μs&quot;" line10="        MicroSeconds" line11="    }" line12="" line13="    export enum DistanceUnit {" line14="        //% block=&quot;cm&quot;" line15="        cm," line16="        //% block=&quot;polegadas&quot;" line17="        inch" line18="    }" line19="" line20="    export enum Color {" line21="        //% block=&quot;Vermelho&quot;" line22="        Red," line23="        //% block=&quot;Verde&quot;" line24="        Green," line25="        //% block=&quot;Azul&quot;" line26="        Blue," line27="        //% block=&quot;Transparente&quot;" line28="        Clear" line29="    }" line30="" line31="    export enum ColorList {" line32="        //% block=&quot;Vermelho&quot;" line33="        red," line34="        //% block=&quot;Verde&quot;" line35="        green," line36="        //% block=&quot;Azul&quot;" line37="        blue," line38="        //% block=&quot;Ciano&quot;" line39="        cyan," line40="        //% block=&quot;Magenta&quot;" line41="        magenta," line42="        //% block=&quot;Amarelo&quot;" line43="        yellow," line44="        //% block=&quot;Branco&quot;" line45="        white" line46="    }" line47="" line48="    export enum GasList {" line49="        //% block=&quot;CO&quot;" line50="        Co," line51="        //% block=&quot;CO2&quot;" line52="        Co2," line53="        //% block=&quot;Fumaça&quot;" line54="        Smoke," line55="        //% block=&quot;Álcool&quot;" line56="        Alcohol" line57="    }" line58="" line59="    export enum LcdPosition1602 {" line60="        Pos1 = 1, Pos2 = 2, Pos3 = 3, Pos4 = 4, Pos5 = 5," line61="        Pos6 = 6, Pos7 = 7, Pos8 = 8, Pos9 = 9, Pos10 = 10," line62="        Pos11 = 11, Pos12 = 12, Pos13 = 13, Pos14 = 14, Pos15 = 15," line63="        Pos16 = 16, Pos17 = 17, Pos18 = 18, Pos19 = 19, Pos20 = 20," line64="        Pos21 = 21, Pos22 = 22, Pos23 = 23, Pos24 = 24, Pos25 = 25," line65="        Pos26 = 26, Pos27 = 27, Pos28 = 28, Pos29 = 29, Pos30 = 30," line66="        Pos31 = 31, Pos32 = 32" line67="    }" line68="" line69="    export enum LcdPosition2004 {" line70="        Pos1 = 1, Pos2 = 2, Pos3 = 3, Pos4 = 4, Pos5 = 5," line71="        Pos6 = 6, Pos7 = 7, Pos8 = 8, Pos9 = 9, Pos10 = 10," line72="        Pos11 = 11, Pos12 = 12, Pos13 = 13, Pos14 = 14, Pos15 = 15," line73="        Pos16 = 16, Pos17 = 17, Pos18 = 18, Pos19 = 19, Pos20 = 20," line74="        Pos21 = 21, Pos22 = 22, Pos23 = 23, Pos24 = 24, Pos25 = 25," line75="        Pos26 = 26, Pos27 = 27, Pos28 = 28, Pos29 = 29, Pos30 = 30," line76="        Pos31 = 31, Pos32 = 32, Pos33 = 33, Pos34 = 34, Pos35 = 35," line77="        Pos36 = 36, Pos37 = 37, Pos38 = 38, Pos39 = 39, Pos40 = 40," line78="        Pos41 = 41, Pos42 = 42, Pos43 = 43, Pos44 = 44, Pos45 = 45," line79="        Pos46 = 46, Pos47 = 47, Pos48 = 48, Pos49 = 49, Pos50 = 50," line80="        Pos51 = 51, Pos52 = 52, Pos53 = 53, Pos54 = 54, Pos55 = 55," line81="        Pos56 = 56, Pos57 = 57, Pos58 = 58, Pos59 = 59, Pos60 = 60," line82="        Pos61 = 61, Pos62 = 62, Pos63 = 63, Pos64 = 64, Pos65 = 65," line83="        Pos66 = 66, Pos67 = 67, Pos68 = 68, Pos69 = 69, Pos70 = 70," line84="        Pos71 = 71, Pos72 = 72, Pos73 = 73, Pos74 = 74, Pos75 = 75," line85="        Pos76 = 76, Pos77 = 77, Pos78 = 78, Pos79 = 79, Pos80 = 80" line86="    }" line87="" line88="    export enum LcdBacklight {" line89="        //% block=&quot;desligada&quot;" line90="        Off = 0," line91="        //% block=&quot;ligada&quot;" line92="        On = 8" line93="    }" line94="" line95="    export enum TextAlignment {" line96="        //% block=&quot;alinhado à esquerda&quot;" line97="        Left," line98="        //% block=&quot;alinhado à direita&quot;" line99="        Right" line100="    }" line101="" line102="    export enum TextOption {" line103="        //% block=&quot;alinhar à esquerda&quot;" line104="        AlignLeft," line105="        //% block=&quot;alinhar à direita&quot;" line106="        AlignRight," line107="        //% block=&quot;preencher com zeros&quot;" line108="        PadWithZeros" line109="    }" line110="" line111="    // ==========================================" line112="    // SUBCATEGORIA: MATEMÁTICA" line113="    // ==========================================" line114="" line115="    //% subcategory=&quot;Matemática&quot;" line116="    //% blockId=sed_somar" line117="    //% block=&quot;%a + %b&quot;" line118="    //% weight=100" line119="    export function somar(a: number, b: number): number {" line120="        return a + b;" line121="    }" line122="" line123="    //% subcategory=&quot;Matemática&quot;" line124="    //% blockId=sed_subtrair" line125="    //% block=&quot;%a - %b&quot;" line126="    //% weight=99" line127="    export function subtrair(a: number, b: number): number {" line128="        return a - b;" line129="    }" line130="" line131="    //% subcategory=&quot;Matemática&quot;" line132="    //% blockId=sed_multiplicar" line133="    //% block=&quot;%a × %b&quot;" line134="    //% weight=98" line135="    export function multiplicar(a: number, b: number): number {" line136="        return a * b;" line137="    }" line138="" line139="    //% subcategory=&quot;Matemática&quot;" line140="    //% blockId=sed_dividir" line141="    //% block=&quot;%a ÷ %b&quot;" line142="    //% weight=97" line143="    export function dividir(a: number, b: number): number {" line144="        if (b == 0) return 0;" line145="        return a / b;" line146="    }" line147="" line148="    //% subcategory=&quot;Matemática&quot;" line149="    //% blockId=sed_mapear" line150="    //% block=&quot;mapear valor %val de [ %fromLow , %fromHigh ] para [ %toLow , %toHigh ]&quot;" line151="    //% weight=96" line152="    export function mapear(val: number, fromLow: number, fromHigh: number, toLow: number, toHigh: number): number {" line153="        return Math.map(val, fromLow, fromHigh, toLow, toHigh);" line154="    }" line155="" line156="    // ==========================================" line157="    // SUBCATEGORIA: SENSORES ULTRASSÔNICOS" line158="    // ==========================================" line159="" line160="    //% subcategory=&quot;Ultrassônico&quot;" line161="    //% blockId=sed_ultrasonic_distance " line162="    //% block=&quot;medidor de distância ultrassônico pino |%name| distância em %Unit&quot;" line163="    //% color=#000080" line164="    export function Ultrasonic(name: DigitalPin, Unit: DistanceUnit): number {" line165="        let duration = 0;" line166="        let RangeInCentimeters = 0;" line167="" line168="        pins.digitalWritePin(name, 0);" line169="        control.waitMicros(2);" line170="        pins.digitalWritePin(name, 1);" line171="        control.waitMicros(10);" line172="        pins.digitalWritePin(name, 0);" line173="" line174="        duration = pins.pulseIn(name, PulseValue.High, 50000);" line175="        RangeInCentimeters = duration / 29 / 2;" line176="" line177="        if (Unit == DistanceUnit.cm)" line178="            return Math.round(RangeInCentimeters);" line179="        else" line180="            return Math.round(RangeInCentimeters / 2.54);" line181="    }" line182="" line183="    //% subcategory=&quot;Ultrassônico&quot;" line184="    //% blockId=sed_ultrasonic_v2_distance " line185="    //% block=&quot;(v2) medidor de distância ultrassônico pino |%name| distância em %Unit&quot;" line186="    //% color=#000080" line187="    export function UltrasonicV2(name: DigitalPin, Unit: DistanceUnit): number {" line188="        let duration2 = 0;" line189="        let RangeInCentimeters2 = 0;" line190="" line191="        pins.digitalWritePin(name, 0);" line192="        control.waitMicros(2);" line193="        pins.digitalWritePin(name, 1);" line194="        control.waitMicros(10);" line195="        pins.digitalWritePin(name, 0);" line196="" line197="        duration2 = pins.pulseIn(name, PulseValue.High, 25000);" line198="        RangeInCentimeters2 = duration2 * 153 / 29 / 2 / 100;" line199="" line200="        if (Unit == DistanceUnit.cm)" line201="            return Math.round(RangeInCentimeters2);" line202="        else" line203="            return Math.round(RangeInCentimeters2 / 2.54);" line204="    }" line205="" line206="    //% subcategory=&quot;Ultrassônico&quot;" line207="    //% blockId=sed_ping " line208="    //% block=&quot;(HC-SR04) ultrassom pino |trig %trig|echo %echo|unidade %unit&quot;" line209="    //% color=#000080" line210="    export function ping(trig: DigitalPin, echo: DigitalPin, unit: PingUnit, maxCmDistance = 500): number {" line211="        pins.setPull(trig, PinPullMode.PullNone);" line212="        pins.digitalWritePin(trig, 0);" line213="        control.waitMicros(2);" line214="        pins.digitalWritePin(trig, 1);" line215="        control.waitMicros(10);" line216="        pins.digitalWritePin(trig, 0);" line217="" line218="        const d = pins.pulseIn(echo, PulseValue.High, maxCmDistance * 58);" line219="" line220="        switch (unit) {" line221="            case PingUnit.cm: return Math.idiv(d, 58);" line222="            case PingUnit.inch: return Math.idiv(d, 148);" line223="            default: return d;" line224="        }" line225="    }" line226="" line227="    // ==========================================" line228="    // SUBCATEGORIA: SENSORES DIGITAIS" line229="    // ==========================================" line230="" line231="    //% subcategory=&quot;Sensores Digitais&quot;" line232="    //% blockId=sed_line_finder " line233="    //% block=&quot;pino |%pin| seguidor de linha detecta preto. Inverter ação |$reverseAction|&quot;" line234="    //% reverseAction.shadow=&quot;toggleOnOff&quot;" line235="    //% color=#000080" line236="    export function lineFinder(pin: DigitalPin, reverseAction?: boolean): boolean {" line237="        if (reverseAction) {" line238="            return pins.digitalReadPin(pin) == 0;" line239="        } else {" line240="            return pins.digitalReadPin(pin) == 1;" line241="        }" line242="    }" line243="" line244="    //% subcategory=&quot;Sensores Digitais&quot;" line245="    //% blockId=sed_collision " line246="    //% block=&quot;sensor de colisão pino |%pin| ativado&quot;" line247="    //% color=#000080" line248="    export function collisionButton(pin: DigitalPin): boolean {" line249="        return pins.digitalReadPin(pin) == 0;" line250="    }" line251="" line252="    //% subcategory=&quot;Sensores Digitais&quot;" line253="    //% blockId=sed_water " line254="    //% block=&quot;sensor de água pino |%pin| detecta água&quot;" line255="    //% color=#000080" line256="    export function waterSensor(pin: DigitalPin): boolean {" line257="        return pins.digitalReadPin(pin) == 1;" line258="    }" line259="" line260="    //% subcategory=&quot;Sensores Digitais&quot;" line261="    //% blockId=sed_magnetic " line262="    //% block=&quot;chave magnética pino |%pin| ativada&quot;" line263="    //% color=#000080" line264="    export function magneticSwitch(pin: DigitalPin): boolean {" line265="        return pins.digitalReadPin(pin) == 0;" line266="    }" line267="" line268="    //% subcategory=&quot;Sensores Digitais&quot;" line269="    //% blockId=sed_hall " line270="    //% block=&quot;sensor hall pino |%pin| ativado&quot;" line271="    //% color=#000080" line272="    export function hallSensor(pin: DigitalPin): boolean {" line273="        return pins.digitalReadPin(pin) == 0;" line274="    }" line275="" line276="    //% subcategory=&quot;Sensores Digitais&quot;" line277="    //% blockId=sed_crash " line278="    //% block=&quot;sensor de impacto |%pin| pressionado&quot;" line279="    //% color=#000080" line280="    export function crashButton(pin: DigitalPin): boolean {" line281="        return pins.digitalReadPin(pin) == 0;" line282="    }" line283="" line284="    //% subcategory=&quot;Sensores Digitais&quot;" line285="    //% blockId=sed_flame " line286="    //% block=&quot;sensor de chama pino |%pin| detecta fogo&quot;" line287="    //% color=#000080" line288="    export function flameSensor(pin: DigitalPin): boolean {" line289="        return pins.digitalReadPin(pin) == 0;" line290="    }" line291="" line292="    //% subcategory=&quot;Sensores Digitais&quot;" line293="    //% blockId=sed_touch " line294="    //% block=&quot;sensor de toque pino |%pin| tocado&quot;" line295="    //% color=#000080" line296="    export function touchSensor(pin: DigitalPin): boolean {" line297="        return pins.digitalReadPin(pin) == 1;" line298="    }" line299="" line300="    //% subcategory=&quot;Sensores Digitais&quot;" line301="    //% blockId=sed_vibration " line302="    //% block=&quot;sensor de vibração pino |%pin| detecta vibração&quot;" line303="    //% color=#000080" line304="    export function vibrationSensor(pin: DigitalPin): boolean {" line305="        return pins.digitalReadPin(pin) == 1;" line306="    }" line307="" line308="    //% subcategory=&quot;Sensores Digitais&quot;" line309="    //% blockId=sed_pir " line310="    //% block=&quot;sensor PIR pino |%pin| detecta movimento&quot;" line311="    //% color=#000080" line312="    export function pirSensor(pin: DigitalPin): boolean {" line313="        return pins.digitalReadPin(pin) == 1;" line314="    }" line315="" line316="    // ==========================================" line317="    // SUBCATEGORIA: SENSORES ANALÓGICOS" line318="    // ==========================================" line319="" line320="    //% subcategory=&quot;Sensores Analógicos&quot;" line321="    //% blockId=sed_raindrop " line322="    //% block=&quot;valor do sensor de chuva (0~100) no pino %raindroppin. Intervalo (leitura) min|%vmin| máx|%vmax|&quot;" line323="    //% vmin.defl=0 vmax.defl=1023" line324="    //% color=#000080" line325="    export function raindropSensor(raindroppin: AnalogPin, vmin: number = 0, vmax: number = 1023): number {" line326="        let value = pins.analogReadPin(raindroppin);" line327="        let rain = Math.map(value, vmin, vmax, 0, 100);" line328="        return Math.round(rain);" line329="    }" line330="" line331="    //% subcategory=&quot;Sensores Analógicos&quot;" line332="    //% blockId=sed_capacitivesoilhumidity " line333="    //% block=&quot;valor da umidade do solo (0~100) no pino %capacitivesoilhumiditypin. Intervalo (leitura) min|%vmin| máx|%vmax|&quot;" line334="    //% vmin.defl=200 vmax.defl=1023" line335="    //% color=#000080" line336="    export function capacitiveSoilHumiditySensor(capacitivesoilhumiditypin: AnalogPin, vmin: number = 200, vmax: number = 1023): number {" line337="        let value2 = pins.analogReadPin(capacitivesoilhumiditypin);" line338="        let humidity = Math.map(value2, vmin, vmax, 100, 0);" line339="        return Math.round(humidity);" line340="    }" line341="" line342="    //% subcategory=&quot;Sensores Analógicos&quot;" line343="    //% blockId=sed_soilhumidity " line344="    //% block=&quot;valor da umidade do solo (0~100) no pino %soilhumiditypin&quot;" line345="    //% color=#000080" line346="    export function soilHumiditySensor(soilhumiditypin: AnalogPin): number {" line347="        let value3 = pins.analogReadPin(soilhumiditypin);" line348="        let humidity2 = Math.map(value3, 0, 1000, 0, 100);" line349="        return Math.round(humidity2);" line350="    }" line351="" line352="    //% subcategory=&quot;Sensores Analógicos&quot;" line353="    //% blockId=sed_lightintensity " line354="    //% block=&quot;valor da intensidade de luz (0~100) no pino %lightintensitypin&quot;" line355="    //% color=#000080" line356="    export function lightIntensitySensor(lightintensitypin: AnalogPin): number {" line357="        let value4 = pins.analogReadPin(lightintensitypin);" line358="        let light = Math.map(value4, 0, 750, 0, 100);" line359="        return Math.round(light);" line360="    }" line361="" line362="    //% subcategory=&quot;Sensores Analógicos&quot;" line363="    //% blockId=sed_uvlevel " line364="    //% block=&quot;sensor UV (0~15) no pino %uvlevelpin&quot;" line365="    //% color=#000080" line366="    export function uvLevelSensor(uvlevelpin: AnalogPin): number {" line367="        let value5 = pins.analogReadPin(uvlevelpin);" line368="        let uv = Math.map(value5, 0, 1023, 0, 15);" line369="        return Math.round(uv);" line370="    }" line371="" line372="    //% subcategory=&quot;Sensores Analógicos&quot;" line373="    //% blockId=sed_temperature " line374="    //% block=&quot;valor da temperatura (Celsius) no pino %temperaturepin&quot;" line375="    //% color=#000080" line376="    export function temperatureSensor(temperaturepin: AnalogPin): number {" line377="        let B = 4275;" line378="        let value6 = pins.analogReadPin(temperaturepin);" line379="        let R = 1023 / value6 - 1.0;" line380="        R = 100000 * R;" line381="        let temperature = 1.0 / (Math.log(R / 100000) / B + 1 / 298.15) - 273.15;" line382="        return Math.round(temperature);" line383="    }" line384="" line385="    //% subcategory=&quot;Sensores Analógicos&quot;" line386="    //% blockId=sed_gas " line387="    //% block=&quot;sensor de gás %sensor no pino %gaspin valor de concentração&quot;" line388="    //% color=#000080" line389="    export function gasSensor(sensor: GasList, gaspin: AnalogPin): number {" line390="        let value7 = pins.analogReadPin(gaspin);" line391="        let gas = Math.map(value7, 0, 1023, 0, 100);" line392="        return Math.round(gas);" line393="    }" line394="" line395="    //% subcategory=&quot;Sensores Analógicos&quot;" line396="    //% blockId=sed_noise " line397="    //% block=&quot;valor do ruído (dB) no pino %noisepin (0~100)&quot;" line398="    //% color=#000080" line399="    export function noiseSensor(noisepin: AnalogPin): number {" line400="        let value8 = pins.analogReadPin(noisepin);" line401="        let noise = Math.map(value8, 0, 1023, 0, 100);" line402="        return Math.round(noise);" line403="    }" line404="" line405="    // ==========================================" line406="    // SUBCATEGORIA: COR E GESTOS (I2C)" line407="    // ==========================================" line408="" line409="    //% subcategory=&quot;Cor e Gestos&quot;" line410="    //% blockId=sed_colorsensor " line411="    //% block=&quot;sensor de cor detectou %Color&quot;" line412="    //% color=#000080" line413="    export function colorSensor(Color: Color): boolean {" line414="        return false;" line415="    }" line416="" line417="    //% subcategory=&quot;Cor e Gestos&quot;" line418="    //% blockId=sed_apds9960_hue " line419="    //% block=&quot;APDS9960 obter matiz da cor HUE (0~360)&quot;" line420="    //% color=#000080" line421="    export function getHue(): number {" line422="        return 0;" line423="    }" line424="" line425="    //% subcategory=&quot;Cor e Gestos&quot;" line426="    //% blockId=sed_apds9960_check_color " line427="    //% block=&quot;sensor de cor APDS9960 detecta %color&quot;" line428="    //% color=#000080" line429="    export function checkColor(color: ColorList): boolean {" line430="        let hue = getHue();" line431="        switch (color) {" line432="            case ColorList.red:" line433="                return (hue &gt;= 330 || hue &lt; 20);" line434="            case ColorList.yellow:" line435="                return (hue &gt;= 20 &amp;&amp; hue &lt; 75);" line436="            case ColorList.green:" line437="                return (hue &gt;= 75 &amp;&amp; hue &lt; 165);" line438="            case ColorList.cyan:" line439="                return (hue &gt;= 165 &amp;&amp; hue &lt; 210);" line440="            case ColorList.blue:" line441="                return (hue &gt;= 210 &amp;&amp; hue &lt; 270);" line442="            case ColorList.magenta:" line443="                return (hue &gt;= 270 &amp;&amp; hue &lt; 330);" line444="            case ColorList.white:" line445="                return true;" line446="            default:" line447="                return false;" line448="        }" line449="    }" line450="" line451="    // ==========================================" line452="    // SUBCATEGORIA: LCD DISPLAY" line453="    // ==========================================" line454="" line455="    const enum Lcd { Command = 0, Data = 1 }" line456="" line457="    interface LcdState {" line458="        i2cAddress: uint8;" line459="        backlight: LcdBacklight;" line460="        characters: Buffer;" line461="        rows: uint8;" line462="        columns: uint8;" line463="        lineNeedsUpdate: uint8;" line464="        refreshIntervalId: number;" line465="    }" line466="" line467="    let lcdState: LcdState = undefined;" line468="" line469="    function connect(): boolean {" line470="        if (0 != pins.i2cReadNumber(39, NumberFormat.Int8LE, false)) {" line471="            connectLcd(39);" line472="        } else if (0 != pins.i2cReadNumber(63, NumberFormat.Int8LE, false)) {" line473="            connectLcd(63);" line474="        }" line475="        return !!lcdState;" line476="    }" line477="" line478="    function write4bits(value: number) {" line479="        if (!lcdState &amp;&amp; !connect()) return;" line480="        pins.i2cWriteNumber(lcdState.i2cAddress, value, NumberFormat.Int8LE);" line481="        pins.i2cWriteNumber(lcdState.i2cAddress, value | 0x04, NumberFormat.Int8LE);" line482="        control.waitMicros(1);" line483="        pins.i2cWriteNumber(lcdState.i2cAddress, value &amp; (0xff ^ 0x04), NumberFormat.Int8LE);" line484="        control.waitMicros(50);" line485="    }" line486="" line487="    function send(RS_bit: number, payload: number) {" line488="        if (!lcdState) return;" line489="        const highnib = payload &amp; 0xf0;" line490="        write4bits(highnib | lcdState.backlight | RS_bit);" line491="        const lownib = (payload &lt;&lt; 4) &amp; 0xf0;" line492="        write4bits(lownib | lcdState.backlight | RS_bit);" line493="    }" line494="" line495="    function sendCommand(command: number) { send(Lcd.Command, command); }" line496="    function sendData(data: number) { send(Lcd.Data, data); }" line497="" line498="    function setCursor(line: number, column: number) {" line499="        const offsets = [0x00, 0x40, 0x14, 0x54];" line500="        sendCommand(0x80 | (offsets[line] + column));" line501="    }" line502="" line503="    function updateCharacterBuffer(" line504="        text: string," line505="        offset: number," line506="        length: number," line507="        columns: number," line508="        rows: number," line509="        alignment: TextAlignment," line510="        pad: string" line511="    ): void {" line512="        if (!lcdState &amp;&amp; !connect()) return;" line513="" line514="        if (!lcdState.refreshIntervalId) {" line515="            lcdState.refreshIntervalId = control.setInterval(refreshDisplay, 500, control.IntervalMode.Timeout);" line516="        }" line517="" line518="        if (lcdState.columns === 0) {" line519="            lcdState.columns = columns;" line520="            lcdState.rows = rows;" line521="            lcdState.characters = pins.createBuffer(lcdState.rows * lcdState.columns);" line522="" line523="            const whitespace = &quot;x&quot;.charCodeAt(0);" line524="            for (let pos = 0; pos &lt; lcdState.rows * lcdState.columns; pos++) {" line525="                lcdState.characters[pos] = whitespace;" line526="            }" line527="            updateCharacterBuffer(&quot;&quot;, 0, lcdState.columns * lcdState.rows, lcdState.columns, lcdState.rows, TextAlignment.Left, &quot; &quot;);" line528="        }" line529="" line530="        if (columns !== lcdState.columns || rows !== lcdState.rows) return;" line531="" line532="        const fillCharacter = pad.length &gt; 0 ? pad.charCodeAt(0) : &quot; &quot;.charCodeAt(0);" line533="        let endPosition = offset + length;" line534="        if (endPosition &gt; lcdState.columns * lcdState.rows) {" line535="            endPosition = lcdState.columns * lcdState.rows;" line536="        }" line537="        let lcdPos = offset;" line538="" line539="        if (alignment == TextAlignment.Right) {" line540="            while (lcdPos &lt; endPosition - text.length) {" line541="                if (lcdState.characters[lcdPos] != fillCharacter) {" line542="                    lcdState.characters[lcdPos] = fillCharacter;" line543="                    lcdState.lineNeedsUpdate |= (1 &lt;&lt; Math.idiv(lcdPos, lcdState.columns));" line544="                }" line545="                lcdPos++;" line546="            }" line547="        }" line548="" line549="        let textPosition = 0;" line550="        while (lcdPos &lt; endPosition &amp;&amp; textPosition &lt; text.length) {" line551="            if (lcdState.characters[lcdPos] != text.charCodeAt(textPosition)) {" line552="                lcdState.characters[lcdPos] = text.charCodeAt(textPosition);" line553="                lcdState.lineNeedsUpdate |= (1 &lt;&lt; Math.idiv(lcdPos, lcdState.columns));" line554="            }" line555="            lcdPos++;" line556="            textPosition++;" line557="        }" line558="" line559="        while (lcdPos &lt; endPosition) {" line560="            if (lcdState.characters[lcdPos] != fillCharacter) {" line561="                lcdState.characters[lcdPos] = fillCharacter;" line562="                lcdState.lineNeedsUpdate |= (1 &lt;&lt; Math.idiv(lcdPos, lcdState.columns));" line563="            }" line564="            lcdPos++;" line565="        }" line566="    }" line567="" line568="    function sendLine(line: number): void {" line569="        setCursor(line, 0);" line570="        for (let position = lcdState.columns * line; position &lt; lcdState.columns * (line + 1); position++) {" line571="            sendData(lcdState.characters[position]);" line572="        }" line573="    }" line574="" line575="    function refreshDisplay() {" line576="        if (!lcdState) return;" line577="        lcdState.refreshIntervalId = undefined;" line578="        for (let i = 0; i &lt; lcdState.rows; i++) {" line579="            if (lcdState.lineNeedsUpdate &amp; (1 &lt;&lt; i)) {" line580="                lcdState.lineNeedsUpdate &amp;= ~(1 &lt;&lt; i);" line581="                sendLine(i);" line582="            }" line583="        }" line584="    }" line585="" line586="    function toAlignment(option?: TextOption): TextAlignment {" line587="        return (option === TextOption.AlignRight || option === TextOption.PadWithZeros) ? TextAlignment.Right : TextAlignment.Left;" line588="    }" line589="" line590="    function toPad(option?: TextOption): string {" line591="        return option === TextOption.PadWithZeros ? &quot;0&quot; : &quot; &quot;;" line592="    }" line593="" line594="    //% subcategory=&quot;LCD&quot;" line595="    //% blockId=&quot;sed_lcd_show_string_on_1602&quot;" line596="    //% block=&quot;LCD1602 exibir %text | na posição %startPosition=sed_lcd_position_1602 com tamanho %length || e %option&quot;" line597="    //% text.shadowOptions.toString=true " line598="    //% length.min=1 length.max=32 length.fieldOptions.precision=1" line599="    //% expandableArgumentMode=&quot;toggle&quot;" line600="    //% inlineInputMode=&quot;inline&quot;" line601="    //% weight=90" line602="    //% color=#000080 " line603="    export function showStringOnLcd1602(text: string, startPosition: number, length: number, option?: TextOption): void {" line604="        updateCharacterBuffer(text, startPosition - 1, length, 16, 2, toAlignment(option), toPad(option));" line605="    }" line606="" line607="    //% subcategory=&quot;LCD&quot;" line608="    //% blockId=&quot;sed_lcd_clear_1602&quot; block=&quot;LCD1602 limpar tela&quot;" line609="    //% weight=89" line610="    //% color=#000080 " line611="    export function clearLcd1602(): void {" line612="        showStringOnLcd1602(&quot;&quot;, 1, 32);" line613="    }" line614="" line615="    //% subcategory=&quot;LCD&quot;" line616="    //% blockId=&quot;sed_lcd_show_string_on_2004&quot;" line617="    //% block=&quot;LCD2004 exibir %text | na posição %startPosition=sed_lcd_position_2004 com tamanho %length || e %option&quot;" line618="    //% text.shadowOptions.toString=true" line619="    //% length.min=1 length.max=80 length.fieldOptions.precision=1" line620="    //% expandableArgumentMode=&quot;toggle&quot;" line621="    //% inlineInputMode=&quot;inline&quot;" line622="    //% weight=80" line623="    //% color=#000080 " line624="    export function showStringOnLcd2004(text: string, startPosition: number, length: number, option?: TextOption): void {" line625="        updateCharacterBuffer(text, startPosition - 1, length, 20, 4, toAlignment(option), toPad(option));" line626="    }" line627="" line628="    //% subcategory=&quot;LCD&quot;" line629="    //% blockId=&quot;sed_lcd_clear_2004&quot; block=&quot;LCD2004 limpar tela&quot;" line630="    //% weight=79" line631="    //% color=#000080 " line632="    export function clearLcd2004(): void {" line633="        showStringOnLcd2004(&quot;&quot;, 1, 80);" line634="    }" line635="" line636="    //% subcategory=&quot;LCD&quot;" line637="    //% blockId=sed_lcd_position_1602" line638="    //% block=&quot;%pos&quot;" line639="    //% pos.fieldEditor=&quot;gridpicker&quot;" line640="    //% pos.fieldOptions.columns=16" line641="    //% blockHidden=true" line642="    //% color=#000080 " line643="    export function position1602(pos: LcdPosition1602): number {" line644="        return pos;" line645="    }" line646="" line647="    //% subcategory=&quot;LCD&quot;" line648="    //% blockId=sed_lcd_position_2004" line649="    //% block=&quot;%pos&quot;" line650="    //% pos.fieldEditor=&quot;gridpicker&quot;" line651="    //% pos.fieldOptions.columns=20" line652="    //% blockHidden=true" line653="    //% color=#000080 " line654="    export function position2004(pos: LcdPosition2004): number {" line655="        return pos;" line656="    }" line657="" line658="    //% subcategory=&quot;LCD&quot;" line659="    //% blockId=&quot;sed_lcd_backlight&quot; block=&quot;alternar luz de fundo do LCD %backlight&quot;" line660="    //% backlight.fieldEditor=&quot;gridpicker&quot;" line661="    //% backlight.fieldOptions.columns=2" line662="    //% weight=79" line663="    //% color=#000080 " line664="    export function setLcdBacklight(backlight: LcdBacklight): void {" line665="        if (!lcdState &amp;&amp; !connect()) return;" line666="        lcdState.backlight = backlight;" line667="        send(Lcd.Command, 0);" line668="    }" line669="" line670="    //% subcategory=&quot;LCD&quot;" line671="    //% blockId=&quot;sed_lcd_set_address&quot; block=&quot;conectar LCD no endereço I2C %i2cAddress&quot;" line672="    //% i2cAddress.min=0 i2cAddress.max=127" line673="    //% weight=70" line674="    //% color=#000080 " line675="    export function connectLcd(i2cAddress: number): void {" line676="        if (lcdState &amp;&amp; lcdState.i2cAddress == i2cAddress) return;" line677="        if (0 === pins.i2cReadNumber(i2cAddress, NumberFormat.Int8LE, false)) return;" line678="" line679="        if (lcdState &amp;&amp; lcdState.refreshIntervalId) {" line680="            control.clearInterval(lcdState.refreshIntervalId, control.IntervalMode.Timeout);" line681="            lcdState.refreshIntervalId = undefined;" line682="        }" line683="" line684="        lcdState = {" line685="            i2cAddress: i2cAddress," line686="            backlight: LcdBacklight.On," line687="            columns: 0," line688="            rows: 0," line689="            characters: undefined," line690="            lineNeedsUpdate: 0," line691="            refreshIntervalId: undefined," line692="        };" line693="" line694="        basic.pause(50);" line695="        pins.i2cWriteNumber(lcdState.i2cAddress, lcdState.backlight, NumberFormat.Int8LE);" line696="        basic.pause(50);" line697="" line698="        write4bits(0x30);" line699="        control.waitMicros(4100);" line700="        write4bits(0x30);" line701="        control.waitMicros(4100);" line702="        write4bits(0x30);" line703="        control.waitMicros(4100);" line704="        write4bits(0x20);" line705="        control.waitMicros(1000);" line706="" line707="        send(Lcd.Command, 0x20 | 0x00 | 0x08 | 0x00);" line708="        control.waitMicros(1000);" line709="        send(Lcd.Command, 0x08 | 0x04 | 0x00 | 0x00);" line710="        control.waitMicros(1000);" line711="        send(Lcd.Command, 0x04 | 0x02 | 0x00);" line712="        control.waitMicros(1000);" line713="    }" line714="" line715="    //% subcategory=&quot;LCD&quot;" line716="    //% blockId=&quot;sed_lcd_is_connected&quot; block=&quot;LCD está conectado&quot;" line717="    //% weight=69" line718="    //% color=#000080 " line719="    export function isLcdConnected(): boolean {" line720="        return !!lcdState || connect();" line721="    }" line722="}" numlines="723"></mutation></block></statement></block></xml>